// Trade result arrays
var array<bool>  resIsWin     = array.new_bool()
var array<int>   resDay       = array.new_int()
var array<float> resTradeRR   = array.new_float()
var array<int>   resTimestamp = array.new_int()
var array<float> resProfit    = array.new_float()
var array<float> resTpPts     = array.new_float()
var array<bool>  resBuy       = array.new_bool()
var array<int>   dayList      = array.new_int()

// Active trades
var array<bool>  tIsBuy     = array.new_bool()
var array<float> tEntry     = array.new_float()
var array<float> tSL        = array.new_float()
var array<float> tTP        = array.new_float()
var array<int>   tBarIdx    = array.new_int()
var array<float> tRiskAmt   = array.new_float()
var array<float> tRRRatio   = array.new_float()
var array<float> tTriggerPx = array.new_float()
var array<float> tPipsDist  = array.new_float()
var array<line>  tEntryLine = array.new_line()

// Flags for alertcondition

// Day tracking (YYYYMMDD format)
int curDayId = (year(time, tz) * 10000) + (month(time, tz) * 100) + dayofmonth(time, tz)
bool needPushDay = array.size(dayList) == 0
if not needPushDay
    needPushDay := array.get(dayList, array.size(dayList) - 1) != curDayId
if needPushDay
    array.push(dayList, curDayId)
    if array.size(dayList) > 400
        array.shift(dayList)

// ==========================================
// --- Trade signal variables  ---
// ==========================================
bool  exitBuyFlat   = false
bool  exitSellFlat  = false
bool  buySignal    = false
bool  sellSignal   = false
float entryPrice   = 0.0
float slPrice      = 0.0
float tpPrice      = 0.0
float pipsDistance = 0.0
float calculatedLot = 0.0
bool  actualIsBuy  = false

// ==========================================
// --- Helper: วาดวงกลม Entry + ลูกศร TP/SL ---
// ==========================================
f_drawEntryMarker(bool _isBuy, float _ent, float _tp, float _sl, string _brkTxt) =>
    if showEntryMarker
        regLabel(label.new(x=bar_index, y=_ent, text="", style=label.style_circle, color=color.new(_isBuy ? color.blue : color.red, 50), size=size.normal))
        regLabel(label.new(x=bar_index, y=_ent, text=_brkTxt, style=_isBuy ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 25), textcolor=color.white, size=size.small))
        regLabel(label.new(x=bar_index, y=_ent, text="", style=label.style_circle, color=color.new(_isBuy ? color.green : color.red, 70), size=size.large))
        float _crop  = math.abs(_ent - _sl) * 0.5
        float _tpEnd = _isBuy ? math.min(_tp, _ent + _crop) : math.max(_tp, _ent - _crop)
        float _slEnd = _isBuy ? math.max(_sl, _ent - _crop) : math.min(_sl, _ent + _crop)
        regLine(line.new(x1=bar_index, y1=_ent, x2=bar_index, y2=_tpEnd, color=color.new(color.green, 70), width=1, style=line.style_arrow_right))
        regLine(line.new(x1=bar_index, y1=_ent, x2=bar_index, y2=_slEnd, color=color.new(color.red, 70), width=1, style=line.style_arrow_right))

// ==========================================
// --- 4.3 ALERT / NOTIFY ---
// ==========================================
// --- ส่ง Alert (Text / OKX / TopstepX): ใช้ตอนออเดอร์เปิด (entry) และตอนปิดด้วย SL/TP (exit) ---
// OKX: ขาออกส่ง percentage_position = สัดส่วน lot ของไม้นั้นต่อ lot รวมที่ยังเปิดทิศเดียวกัน
// TopstepX: ส่งเฉพาะ action (buy/sell/close) + id ตามที่ bot python รับ (บอทกดคีย์ลัด ไม่รับ level/SL/TP/lot) ขนาดสัญญาตั้งใน TopstepX
// ขาออกส่ง "close" เฉพาะเมื่อเป็นไม้สุดท้ายของทิศนั้น (close = Close Position ปิดทั้ง position)
f_notify(string _evt, bool _isBuy, string _lv, float _ent, float _sl, float _tp, float _lot, float _r, float _pct, bool _flat) =>
    string _dir = _isBuy ? "BUY" : "SELL"
    string _act = _isBuy ? "buy" : "sell"
    string _id  = str.tostring(time) + "-" + str.tostring(bar_index) + "-" + _lv + "-" + _evt
    if whMode == "Text only (pop-up)"
        string _txt = syminfo.ticker + " [" + _lv + "] " + (_evt == "entry" ? _dir + " ENTRY @ " + str.tostring(_ent, format.mintick) + "  SL " + str.tostring(_sl, format.mintick) + "  TP " + str.tostring(_tp, format.mintick) + "  Lot " + str.tostring(_lot, "#.##") : "EXIT " + _dir + " " + (_r > 0 ? "WIN +" : "LOSS ") + str.tostring(_r, "#.##") + "R")
        alert(_txt, alert.freq_all)
    else if whMode == "OKX Signal Bot"
        if str.length(whSignalToken) > 0
            string _ts   = str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
            string _okxA = _evt == "entry" ? (_isBuy ? "ENTER_LONG" : "ENTER_SHORT") : (_isBuy ? "EXIT_LONG" : "EXIT_SHORT")
            string _head = '{"action":"' + _okxA + '","instrument":"' + whInstId + '","signalToken":"' + whSignalToken + '","timestamp":"' + _ts + '","maxLag":"' + str.tostring(okxMaxLag) + '","orderType":"market"'
            string _size = _evt == "exit" ? ',"investmentType":"percentage_position","amount":"' + str.tostring(math.min(100.0, _pct), "#.##") + '"' : okxSizeMode == "Bot setting" ? "" : ',"investmentType":"' + okxSizeMode + '","amount":"' + str.tostring(okxAmount, "#.####") + '"'
            alert(_head + _size + '}', alert.freq_all)
    else if whMode == "TopstepX Clicker"
        string _hd = '{"secret":"' + whSecret + '","t":' + str.tostring(timenow)
        if _evt == "entry"
            alert(_hd + ',"action":"' + _act + '","event":"entry","id":"' + _id + '"}', alert.freq_all)
        else if _flat
            alert(_hd + ',"action":"close","event":"exit","id":"' + _id + '"}', alert.freq_all)
// ==========================================
// --- 4.4 SWING BREAK → RETEST 50% ENTRY (counter-trend) ---
// ==========================================
// 1) Swing High confirm แล้วราคาเบรค High นั้น (ก่อน Swing Low ใหม่ confirm) → "ไม่เข้า" ตอนเบรค
// 2) วัดช่วง: Low ต่ำสุดตั้งแต่แท่ง Swing High ถึงแท่งที่เบรค → ระดับ Swing High ที่ถูกเบรค ; 50% = จุดกึ่งกลางช่วงนี้
// 3) รอราคาวิ่งกลับลงมาแตะระดับ 50% (แท่งหลังแท่งเบรค) → เปิด SELL ที่ระดับ 50%
//    SL เหนือ High สูงสุดหลังเบรค (± buffer) × slPct, TP = Low (Swing Low) ล่าสุดก่อนเกิด High
// 4) ถ้า Swing High ใหม่ confirm ก่อนราคาย้อนมาแตะ 50% → ยกเลิก setup
// ฝั่งกลับด้าน: เบรค Swing Low → รอราคาขึ้นมาแตะ 50% ของช่วง (High สูงสุด → Swing Low) → เปิด BUY, ยกเลิกเมื่อ Swing Low ใหม่ confirm
var float lastSwH    = na
var float lastSwL    = na
var int   lastSwHBar = na
var int   lastSwLBar = na
var bool  swHUsed    = true   // true = ไม่มี Swing High รอเบรค
var bool  swLUsed    = true
var bool  hWait      = false  // เบรค High แล้ว รอ retest 50% เพื่อ SELL
var bool  lWait      = false  // เบรค Low แล้ว รอ retest 50% เพื่อ BUY
var float hLvl       = na
var float hPeak      = na   // High สูงสุดหลังเบรค
var float hTP        = na   // Swing Low ล่าสุดก่อนเกิด High
var float hMid       = na
var int   hBrkBar    = na
var float lLvl       = na
var float lPeak      = na   // Low ต่ำสุดหลังเบรค
var float lTP        = na   // Swing High ล่าสุดก่อนเกิด Low
var float lMid       = na
var int   lBrkBar    = na

if not na(fracHighVal)
    lastSwH    := fracHighVal
    lastSwHBar := bar_index - lbR
    swHUsed    := false   // arm: รอเบรค High นี้
    swLUsed    := true    // High confirm ก่อนเบรค Low = ยกเลิก setup เบรค Low
    hWait      := false   // Swing High ใหม่ confirm ก่อน retest = ยกเลิก
if not na(fracLowVal)
    lastSwL    := fracLowVal
    lastSwLBar := bar_index - lbR
    swLUsed    := false
    swHUsed    := true
    lWait      := false

bool brkClose = brkMode == "รอแท่งปิด (Bar Close)"
bool dayOK    = array.get(array.from(tradeSun, tradeMon, tradeTue, tradeWed, tradeThu, tradeFri, tradeSat), dayofweek(time, tz) - 1)

// --- เบรค Swing High → เริ่มรอ retest 50% (ยังไม่เข้าออเดอร์) ---
if not swHUsed and high > lastSwH
    swHUsed := true
    float refLowB = low
    for k = 1 to math.min(bar_index - lastSwHBar, 900)
        refLowB := math.min(refLowB, low[k])
    hWait   := true
    hLvl    := lastSwH
    hPeak   := high
    hTP     := lastSwL
    hMid    := refLowB + 0.5 * (lastSwH - refLowB)
    hBrkBar := bar_index
    if showBreakLine
        regLine(line.new(lastSwHBar, lastSwH, bar_index, lastSwH, color=color.new(color.green, 10), width=2, style=line.style_dashed))
        regLine(line.new(lastSwHBar, hMid, bar_index + 10, hMid, color=color.new(color.orange, 20), width=1, style=line.style_dotted))

// --- เบรค Swing Low → เริ่มรอ retest 50% ---
if not swLUsed and low < lastSwL
    swLUsed := true
    float refHighS = high
    for k = 1 to math.min(bar_index - lastSwLBar, 900)
        refHighS := math.max(refHighS, high[k])
    lWait   := true
    lLvl    := lastSwL
    lPeak   := low
    lTP     := lastSwH
    lMid    := refHighS - 0.5 * (refHighS - lastSwL)
    lBrkBar := bar_index
    if showBreakLine
        regLine(line.new(lastSwLBar, lastSwL, bar_index, lastSwL, color=color.new(color.red, 10), width=2, style=line.style_dashed))
        regLine(line.new(lastSwLBar, lMid, bar_index + 10, lMid, color=color.new(color.orange, 20), width=1, style=line.style_dotted))

// --- SELL: ราคาย้อนลงมาแตะ 50% (แท่งหลังแท่งเบรค) ---
if hWait and bar_index > hBrkBar and low <= hMid and (not brkClose or barstate.isconfirmed)
    hWait := false
    float fillS = brkClose ? close : math.min(open, hMid)
    float peakH = brkClose ? math.max(hPeak, high) : hPeak
    float distS = ((peakH + slBufferPts) - fillS) * slPct / 100.0
    float tpS   = hTP
    if dayOK and distS > 0 and not na(tpS) and tpS < fillS
        float slS = fillS + distS
        entryPrice    := fillS
        slPrice       := slS
        tpPrice       := tpS
        pipsDistance  := distS
        calculatedLot := riskAmount / (distS * pipValueRatio)
        actualIsBuy   := false
        sellSignal    := true
        array.push(tIsBuy,     false)
        array.push(tEntry,     fillS)
        array.push(tSL,        slS)
        array.push(tTP,        tpS)
        array.push(tBarIdx,    bar_index)
        array.push(tRiskAmt,   riskAmount)
        array.push(tRRRatio,   (fillS - tpS) / distS)
        array.push(tTriggerPx, hMid)
        array.push(tPipsDist,  distS)
        f_notify("entry", false, "Retest 50%", fillS, slS, tpS, calculatedLot, 0.0, 0.0, false)
        if showConfirmLabel
            float cfGapS = math.max(high - low, syminfo.mintick * 10) * 0.6
            regLabel(label.new(bar_index, high + cfGapS, "▼ SELL Retest 50%\nEntry " + str.tostring(fillS, format.mintick) + "\nSL " + str.tostring(slS, format.mintick) + "  TP " + str.tostring(tpS, format.mintick) + "\nLot " + str.tostring(calculatedLot, "#.##"), style=label.style_label_down, color=color.new(color.maroon, 12), textcolor=color.white, size=size.small))
        line lnS = na
        if showEntryLine
            lnS := line.new(x1=bar_index, y1=fillS, x2=bar_index+1, y2=fillS, color=color.new(color.orange, 30), width=2, style=line.style_solid)
        array.push(tEntryLine, lnS)
        f_drawEntryMarker(false, fillS, tpS, slS, "Retest 50% ↓")

// --- BUY: ราคาย้อนขึ้นมาแตะ 50% (แท่งหลังแท่งเบรค) ---
if lWait and bar_index > lBrkBar and high >= lMid and (not brkClose or barstate.isconfirmed)
    lWait := false
    float fillB = brkClose ? close : math.max(open, lMid)
    float peakL = brkClose ? math.min(lPeak, low) : lPeak
    float distB = (fillB - (peakL - slBufferPts)) * slPct / 100.0
    float tpB   = lTP
    if dayOK and distB > 0 and not na(tpB) and tpB > fillB
        float slB = fillB - distB
        entryPrice    := fillB
        slPrice       := slB
        tpPrice       := tpB
        pipsDistance  := distB
        calculatedLot := riskAmount / (distB * pipValueRatio)
        actualIsBuy   := true
        buySignal     := true
        array.push(tIsBuy,     true)
        array.push(tEntry,     fillB)
        array.push(tSL,        slB)
        array.push(tTP,        tpB)
        array.push(tBarIdx,    bar_index)
        array.push(tRiskAmt,   riskAmount)
        array.push(tRRRatio,   (tpB - fillB) / distB)
        array.push(tTriggerPx, lMid)
        array.push(tPipsDist,  distB)
        f_notify("entry", true, "Retest 50%", fillB, slB, tpB, calculatedLot, 0.0, 0.0, false)
        if showConfirmLabel
            float cfGapB = math.max(high - low, syminfo.mintick * 10) * 0.6
            regLabel(label.new(bar_index, low - cfGapB, "▲ BUY Retest 50%\nEntry " + str.tostring(fillB, format.mintick) + "\nSL " + str.tostring(slB, format.mintick) + "  TP " + str.tostring(tpB, format.mintick) + "\nLot " + str.tostring(calculatedLot, "#.##"), style=label.style_label_up, color=color.new(color.teal, 12), textcolor=color.white, size=size.small))
        line lnB = na
        if showEntryLine
            lnB := line.new(x1=bar_index, y1=fillB, x2=bar_index+1, y2=fillB, color=color.new(color.orange, 30), width=2, style=line.style_solid)
        array.push(tEntryLine, lnB)
        f_drawEntryMarker(true, fillB, tpB, slB, "Retest 50% ↑")

// --- อัปเดตจุดสุดขั้วหลังเบรค (ใช้คิด SL ของแท่งถัดไป) ---
if hWait
    hPeak := math.max(hPeak, high)
if lWait
    lPeak := math.min(lPeak, low)

// ==========================================
// --- 4.7 EXTEND ENTRY LINES (ต่อยาวทุก bar) ---
// ==========================================
if array.size(tEntryLine) > 0 and showEntryLine
    for k = 0 to array.size(tEntryLine) - 1
        line ln = array.get(tEntryLine, k)
        if not na(ln)
            line.set_x2(ln, bar_index + 1)

// ==========================================
// --- 5. TRADE RESULT TRACKING ---
// ==========================================
if array.size(tEntry) > 0
    for i = array.size(tEntry) - 1 to 0
        if bar_index >= array.get(tBarIdx, i)
            bool  isB       = array.get(tIsBuy,     i)
            float ent       = array.get(tEntry,     i)
            float sl        = array.get(tSL,        i)
            float tp        = array.get(tTP,        i)
            float rAmt      = array.get(tRiskAmt,   i)
            float rr        = array.get(tRRRatio,   i)
            float trigPx    = array.get(tTriggerPx, i)
            int   originBar = array.get(tBarIdx,    i)
            float dist      = array.get(tPipsDist,  i)
            line  entryLn   = array.get(tEntryLine, i)

            bool  closedWin  = false
            bool  closedLoss = false

            if bar_index > originBar
                if isB
                    if low  <= sl
                        closedLoss := true
                    else if high >= tp
                        closedWin  := true
                else
                    if high >= sl
                        closedLoss := true
                    else if low  <= tp
                        closedWin  := true
            else if not brkClose
                // แท่งเดียวกับที่เปิดออเดอร์: ใช้ทิศแท่งเดาลำดับ (แท่งขึ้น: low→high / แท่งลง: high→low) ตัดสินทันทีที่ราคาถึง
                bool barBull = close > open
                bool barBear = close < open
                if isB
                    if inBarSL and barBear and low <= sl
                        closedLoss := true
                    else if inBarTP and barBull and high >= tp
                        closedWin  := true
                else
                    if inBarSL and barBull and high >= sl
                        closedLoss := true
                    else if inBarTP and barBear and low <= tp
                        closedWin  := true

            if closedWin or closedLoss
                float closedAt   = closedWin ? tp : sl
                // วัดแบบ MT5: แต่ละไม้มี lot, ระยะ SL/TP (จุด) ของตัวเอง → กำไรขาดทุนเป็น $ → เทียบกลับเป็น R
                float slPts      = math.abs(ent - sl)
                float tpPts      = math.abs(tp - ent)
                float lotOrder   = slPts > 0 ? rAmt / (slPts * pipValueRatio) : 0.0
                float profitUsd  = closedWin ? lotOrder * tpPts * pipValueRatio : -(lotOrder * slPts * pipValueRatio)
                // R = กำไร/ขาดทุน ÷ ความเสี่ยงที่ตั้งของไม้นั้น (1R = ระยะ SL): ชนะ = TP÷SL, แพ้ = -1R
                float winR       = slPts > 0 ? tpPts / slPts : rr
                float lossR      = -1.0
                float actualR    = rAmt > 0 ? profitUsd / rAmt : 0.0
                float closePts   = math.abs(closedAt - ent)
                bool  statAsWin  = closedWin
                string resultTag = "Break"
                float sameLots = 0.0
                int   sameCnt  = 0
                for q = 0 to array.size(tIsBuy) - 1
                    if array.get(tIsBuy, q) == isB
                        float sdq = math.abs(array.get(tEntry, q) - array.get(tSL, q))
                        sameLots += sdq > 0 ? array.get(tRiskAmt, q) / (sdq * pipValueRatio) : 0.0
                        sameCnt += 1
                f_notify("exit", isB, "Retest 50%", closedAt, sl, tp, lotOrder, actualR, sameLots > 0 ? lotOrder / sameLots * 100.0 : 100.0, sameCnt <= 1)
                if sameCnt <= 1
                    if isB
                        exitBuyFlat := true
                    else
                        exitSellFlat := true

                // === บันทึกผล ===
                array.push(resIsWin,     statAsWin)
                array.push(resDay,       curDayId)
                array.push(resTradeRR,   actualR)
                array.push(resTimestamp, time)
                array.push(resProfit,    profitUsd)
                array.push(resTpPts,     closePts)
                array.push(resBuy,       isB)

                if array.size(resIsWin) > 5000
                    array.shift(resIsWin)
                    array.shift(resDay)
                    array.shift(resTradeRR)
                    array.shift(resTimestamp)
                    array.shift(resProfit)
                    array.shift(resTpPts)
                    array.shift(resBuy)

                // === Label ผลลัพธ์ (แยก Main/Reco) ===
                if closedWin
                    regLabel(label.new(x=bar_index, y=tp, text="✔ Win " + resultTag + "\n+" + str.tostring(winR, "#.##") + "R  +$" + str.tostring(profitUsd, "#.##") + "\nTP " + str.tostring(tpPts, "#.##") + " pts / SL " + str.tostring(slPts, "#.##") + " pts", color=color.new(color.green, 20), textcolor=color.white, style=isB ? label.style_label_down : label.style_label_up, size=size.small))
                    regLine(line.new(x1=bar_index - 3, y1=tp, x2=bar_index + 3, y2=tp, color=color.green, width=2))
                else
                    regLabel(label.new(x=bar_index, y=sl, text="✘ Loss " + resultTag + "\n" + str.tostring(lossR, "#.##") + "R  -$" + str.tostring(-profitUsd, "#.##") + "\nSL " + str.tostring(slPts, "#.##") + " pts / TP " + str.tostring(tpPts, "#.##") + " pts", color=color.new(color.red, 20), textcolor=color.white, style=isB ? label.style_label_up : label.style_label_down, size=size.small))
                    regLine(line.new(x1=bar_index - 3, y1=sl, x2=bar_index + 3, y2=sl, color=color.red, width=2))

                // === Trade Path (Entry → จุดปิด) ===
                if showTradePath
                    color pathCol = closedWin ? color.new(color.green, 40) : color.new(color.red, 40)
                    regLine(line.new(x1=originBar, y1=ent, x2=bar_index, y2=closedAt, color=pathCol, width=1, style=line.style_dashed))

                // === หยุด Entry Line ที่จุดปิด ===
                if not na(entryLn)
                    line.set_x2(entryLn, bar_index)
                    line.set_color(entryLn, color.new(closedWin ? color.green : color.red, 60))

                // ลบเทรดออกจาก active arrays
                array.remove(tIsBuy,     i)
                array.remove(tEntry,     i)
                array.remove(tSL,        i)
                array.remove(tTP,        i)
                array.remove(tBarIdx,    i)
                array.remove(tRiskAmt,   i)
                array.remove(tRRRatio,   i)
                array.remove(tTriggerPx, i)
                array.remove(tPipsDist,  i)
                array.remove(tEntryLine, i)

// ==========================================
// --- 6. DISPLAY ARROWS + CONFIRMED LABEL ---
// ==========================================
plotshape(buySignal,  title="Buy Arrow",  style=shape.arrowup,   location=location.belowbar, color=color.green, size=size.normal)
plotshape(sellSignal, title="Sell Arrow", style=shape.arrowdown, location=location.abovebar, color=color.red,   size=size.normal)


// ==========================================
// --- 7. STAT PERIOD COMPUTATION ---
// ==========================================
int targetMonthNum = statMode == "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)" ? month(selToTime, tz) : statTargetM == "January" ? 1 : statTargetM == "February" ? 2 : statTargetM == "March" ? 3 : statTargetM == "April" ? 4 : statTargetM == "May" ? 5 : statTargetM == "June" ? 6 : statTargetM == "July" ? 7 : statTargetM == "August" ? 8 : statTargetM == "September" ? 9 : statTargetM == "October" ? 10 : statTargetM == "November" ? 11 : 12

int nDaysDraw  = math.min(statDays, array.size(dayList))
int cutoffDraw = 0
if array.size(dayList) > 0
    cutoffDraw := array.get(dayList, array.size(dayList) - nDaysDraw)

int currentTotalM = year(timenow, tz) * 12 + month(timenow, tz)

// Helper: ตรวจว่า timestamp อยู่ในช่วงสถิติที่เลือกหรือไม่
f_inStatPeriod(int t) =>
    int tDayId = (year(t, tz) * 10000) + (month(t, tz) * 100) + dayofmonth(t, tz)
    bool ok = false
    if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
        ok := tDayId >= cutoffDraw
    else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
        ok := (year(t, tz) * 12 + month(t, tz)) >= (currentTotalM - statMonths + 1)
    else if statMode == "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)"
        ok := tDayId >= selFromId and tDayId <= selToId
    else
        ok := month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
    ok

// ==========================================
// --- 8. CLEANUP DRAWINGS BY STAT PERIOD ---
// ==========================================
if limitDrawDays and barstate.islast
    if array.size(regBoxes) > 0
        for i = array.size(regBoxes) - 1 to 0
            if not f_inStatPeriod(array.get(regBoxTime, i))
                box.delete(array.get(regBoxes, i))
                array.remove(regBoxes, i)
                array.remove(regBoxTime, i)
    if array.size(regLines) > 0
        for i = array.size(regLines) - 1 to 0
            if not f_inStatPeriod(array.get(regLineTime, i))
                line.delete(array.get(regLines, i))
                array.remove(regLines, i)
                array.remove(regLineTime, i)
    if array.size(regLabels) > 0
        for i = array.size(regLabels) - 1 to 0
            if not f_inStatPeriod(array.get(regLabelTime, i))
                label.delete(array.get(regLabels, i))
                array.remove(regLabels, i)
                array.remove(regLabelTime, i)

// ==========================================
// --- โหมดรวมตารางเดียว (All-in-one): ผัง 16 คอลัมน์ฐาน, แต่ละส่วนมี row offset + การแบ่งคอลัมน์ ---
// ==========================================
bool uniMode  = tblMode == "รวมตารางเดียว (All-in-one)"
int rowsMain  = 8
int rowsDate  = 7
int rowsSet   = 16
int rowsDay   = 3 + enabledDayCnt
int rowsDaily = 34
int rowsMon   = statMonths + 3
int rowsEnt   = 5
int rowsPerf  = 10
// Tablet / Phone: ปิดตารางเต็มทั้งหมด ใช้ตารางย่อ (cmpTbl) แทน
bool statsOn   = not hideAllStats and not cmpMode
bool cmpOn     = not hideAllStats and cmpMode
int rowsGame  = statsOn ? (showPacman ? 1 : 0) + (showCrypto ? 1 : 0) : 0
int rowsScore = 2
int uR        = 1
bool onGame   = gTheme and rowsGame > 0 and (not uniMode or uR + rowsGame <= 100)
int offGame   = uR
uR := uR + (uniMode and onGame ? rowsGame : 0)
bool onScore  = statsOn and showScore and (not uniMode or uR + rowsScore <= 100)
int offScore  = uR
uR := uR + (uniMode and onScore ? rowsScore : 0)
bool onPerf   = statsOn and showPerfTable and (not uniMode or uR + rowsPerf <= 100)
int offPerf   = uR
uR := uR + (uniMode and onPerf ? rowsPerf : 0)
bool onMain   = statsOn and showStatsTable and (not uniMode or uR + rowsMain <= 100)
int offMain   = uR
uR := uR + (uniMode and onMain ? rowsMain : 0)
bool onDate   = statsOn and showDateTable and (not uniMode or uR + rowsDate <= 100)
int offDate   = uR
uR := uR + (uniMode and onDate ? rowsDate : 0)
bool onEnt    = statsOn and showEntryTable and (not uniMode or uR + rowsEnt <= 100)
int offEnt    = uR
uR := uR + (uniMode and onEnt ? rowsEnt : 0)
bool onDay    = showDayTable and onMain and (not uniMode or uR + rowsDay <= 100)
int offDay    = uR
uR := uR + (uniMode and onDay ? rowsDay : 0)
bool onMon    = statsOn and showMonthlyTable and (not uniMode or uR + rowsMon <= 100)
int offMon    = uR
uR := uR + (uniMode and onMon ? rowsMon : 0)
bool onDaily  = statsOn and showDailyTable and (not uniMode or uR + rowsDaily <= 100)
int offDaily  = uR
uR := uR + (uniMode and onDaily ? rowsDaily : 0)
bool onSet    = statsOn and showSettingsTable and (not uniMode or uR + rowsSet <= 100)
int offSet    = uR
uR := uR + (uniMode and onSet ? rowsSet : 0)
int uniRows   = math.max(uR, 2)

array<int> spDay   = array.from(4, 4, 4, 4)
array<int> spDaily = array.from(2, 3, 2, 3, 3, 3)
array<int> spMon   = array.from(3, 4, 3, 3, 3)
array<int> spScore = array.from(4, 4, 4, 4)
array<int> spEnt   = array.from(2, 2, 2, 2, 2, 2, 2, 2)

// ตารางตำแหน่งคำนวณครั้งเดียว: คอลัมน์เริ่มของแต่ละส่วน (ส่วน*16 + คอลัมน์ตรรกะ), แถวฐาน, จำนวนแถวหัว (ส่วนที่วาง 2 คู่ต่อแถว)
f_pre(array<int> _sp) =>
    array<int> _o = array.new<int>(16, 0)
    int _n = array.size(_sp)
    int _s = 0
    for k = 0 to 15
        array.set(_o, k, _n == 0 ? k : _s)
        _s += k < _n ? array.get(_sp, k) : 0
    _o

f_start(array<int> _sp, int _c) =>
    int _s = 0
    if _c > 0
        for k = 0 to _c - 1
            _s += array.get(_sp, k)
    _s

array<int> spNone = array.new<int>(0)
var array<int> uCS = f_pre(spNone)
if barstate.isfirst
    array.concat(uCS, f_pre(spNone))
    array.concat(uCS, f_pre(spNone))
    array.concat(uCS, f_pre(spDay))
    array.concat(uCS, f_pre(spDaily))
    array.concat(uCS, f_pre(spMon))
    array.concat(uCS, f_pre(spEnt))
    array.concat(uCS, f_pre(spNone))
    array.concat(uCS, f_pre(spNone))
    array.concat(uCS, f_pre(spScore))
array<int> uOff = array.from(offMain, offDate, offSet, offDay, offDaily, offMon, offEnt, offPerf, offGame, offScore)
array<int> uHdr = array.from(2, 1, 1, -1, -1, -1, -1, -1, -1, -1)

// คอลัมน์/แถวฐานของเซลล์ (section, คอลัมน์ตรรกะ, แถวตรรกะ) — โหมดแยกตาราง = ค่าเดิม
f_uc(int _sec, int _c, int _r) =>
    int _h = array.get(uHdr, _sec)
    not uniMode ? _c : _h < 0 ? array.get(uCS, _sec * 16 + _c) : _r < _h ? _c : ((_r - _h) % 2) * 8 + _c * 4

f_ur(int _sec, int _c, int _r) =>
    int _h = array.get(uHdr, _sec)
    not uniMode ? _r : array.get(uOff, _sec) + (_h < 0 or _r < _h ? _r : _h + int((_r - _h) / 2))

// เซลล์ที่ตำแหน่งขึ้นกับโหมดตาราง (แยก / รวมตารางเดียว) — ส่วน _sec คอลัมน์ _c แถว _r
f_ut(table _t, int _sec, int _c, int _r, string _s, color _tc, string _sz, color _bg, string _al = text.align_center) =>
    f_tc(_t, f_uc(_sec, _c, _r), f_ur(_sec, _c, _r), _s, _tc, _sz, _bg, _al)

f_mg(table _t, int _a, int _b, int _c, int _d) =>
    if not uniMode
        table.merge_cells(_t, _a, _b, _c, _d)

// ==========================================
// --- 9. STATS TABLES ---
// ==========================================
var table statsTable        = uniMode ? na : table.new(f_tablePos(mainTablePosStr),     2, 14,               bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dayStatsTable     = uniMode ? na : table.new(f_tablePos(dayTablePosStr),      4, 3 + enabledDayCnt, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dailyStatsTable   = uniMode ? na : table.new(f_tablePos(dailyTablePosStr),    6, 34,               bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table monthlyStatsTable = uniMode ? na : table.new(f_tablePos(monthlyTablePosStr),  5, statMonths + 3,   bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table settingsTable     = uniMode ? na : table.new(f_tablePos(settingsTablePosStr), 2, 30,               bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var bool lxMerged1 = false
var bool lxMerged2 = false
var bool lxMerged3 = false
var table perfTbl            = uniMode ? na : table.new(f_tablePos(perfTablePosStr),     16, 10, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=0, border_color=lxGrid)
var table uniTbl = uniMode ? table.new(f_tablePos(uniTablePosStr), 16, uniRows, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid) : na
var bool lxMergedU = false
var bool lxMergedP = false
var bool lxMergedE = false
var table gameTbl           = (uniMode or not gTheme or rowsGame == 0) ? na : table.new(f_tablePos(uniTablePosStr), 16, math.max(rowsGame, 1), bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=0, border_color=lxGrid)
var table scoreTbl          = (uniMode or not showScore) ? na : table.new(f_tablePos(scoreTablePosStr), 4, 2, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dashTbl           = (not showDash or not statsOn) ? na : table.new(f_tablePos(dashTablePosStr), 28, 32, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dateSumTbl         = uniMode ? na : table.new(f_tablePos(dateTablePosStr),     2, 14, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table entryTbl          = uniMode ? na : table.new(f_tablePos(entryTablePosStr),    8, 5, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
table tMain  = uniMode ? uniTbl : statsTable
table tDate  = uniMode ? uniTbl : dateSumTbl
table tSet   = uniMode ? uniTbl : settingsTable
table tDay   = uniMode ? uniTbl : dayStatsTable
table tDaily = uniMode ? uniTbl : dailyStatsTable
table tMon   = uniMode ? uniTbl : monthlyStatsTable
table tEnt   = uniMode ? uniTbl : entryTbl
table tPerf  = uniMode ? uniTbl : perfTbl
table tGame  = uniMode ? uniTbl : gameTbl
table tScore = uniMode ? uniTbl : scoreTbl
var bool lxMerged4 = false

// --- period string ---
string periodStr = ""
if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
    periodStr := "Last " + str.tostring(statDays) + " Days"
else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
    periodStr := "Last " + str.tostring(statMonths) + " Months"
else if statMode == "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)"
    periodStr := statUseToday ? "Today " + str.format_time(timenow, "dd/MM/yy", tz) : str.format_time(statFrom, "dd/MM/yy", tz) + " – " + str.format_time(statTo, "dd/MM/yy", tz)
else
    periodStr := statTargetM + " " + str.tostring(actualTargetY)

// ==========================================
// --- ตารางที่ 1: MAIN STATS + Day-of-week ---
// ==========================================
f_drawMain() =>
    var bool mgl1 = false
    var bool mgl2 = false
    int   winCnt  = 0
    int   lossCnt = 0
    int   streak  = 0
    int   maxW    = 0
    int   maxL    = 0
    int   curStreakStart = 0
    int   maxWStart = 0
    int   maxWEnd   = 0
    int   maxLStart = 0
    int   maxLEnd   = 0
    float netR      = 0.0
    float peakR     = 0.0
    float maxDD     = 0.0
    float totalProfit = 0.0
    float grossWinR  = 0.0
    float grossLossR = 0.0
    float curWinSum  = 0.0
    float curLossSum = 0.0
    float maxWinR    = 0.0
    float maxLossR   = 0.0
    int   maxWinRStart  = 0
    int   maxWinREnd    = 0
    int   maxLossRStart = 0
    int   maxLossREnd   = 0
    float curWinPips  = 0.0
    float curLossPips = 0.0
    float maxWinPips  = 0.0
    float maxLossPips = 0.0

    array<int>   dowWin  = array.new_int(8, 0)
    array<int>   dowLoss = array.new_int(8, 0)
    array<float> dowNetR = array.new_float(8, 0.0)

    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTimestamp, i)
            if f_inStatPeriod(t)
                float tradeR = array.get(resTradeRR, i)
                bool  isWin  = array.get(resIsWin, i)
                float tPips  = array.get(resTpPts, i)
                float tProf  = array.get(resProfit, i)
                int   dow    = dayofweek(t, tz)

                netR += tradeR
                peakR := math.max(peakR, netR)
                maxDD := math.max(maxDD, peakR - netR)
                totalProfit += tProf
                if streak == 0
                    curStreakStart := t
                if isWin
                    winCnt += 1
                    grossWinR += tradeR
                    curWinSum  := streak >= 0 ? curWinSum + tradeR : tradeR
                    curWinPips := streak >= 0 ? curWinPips + tPips : tPips
                    if streak < 0
                        curStreakStart := t
                    streak := streak >= 0 ? streak + 1 : 1
                    if streak > maxW
                        maxW := streak
                        maxWStart := curStreakStart
                        maxWEnd := t
                    if curWinSum > maxWinR
                        maxWinR := curWinSum
                        maxWinRStart := curStreakStart
                        maxWinREnd := t
                    maxWinPips := math.max(maxWinPips, curWinPips)
                    if dow >= 1 and dow <= 7
                        array.set(dowWin,  dow, array.get(dowWin,  dow) + 1)
                        array.set(dowNetR, dow, array.get(dowNetR, dow) + tradeR)
                else
                    lossCnt += 1
                    grossLossR += math.abs(tradeR)
                    curLossSum  := streak <= 0 ? curLossSum + tradeR : tradeR
                    curLossPips := streak <= 0 ? curLossPips - tPips : -tPips
                    if streak > 0
                        curStreakStart := t
                    streak := streak <= 0 ? streak - 1 : -1
                    if -streak > maxL
                        maxL := -streak
                        maxLStart := curStreakStart
                        maxLEnd := t
                    if curLossSum < maxLossR
                        maxLossR := curLossSum
                        maxLossRStart := curStreakStart
                        maxLossREnd := t
                    maxLossPips := math.min(maxLossPips, curLossPips)
                    if dow >= 1 and dow <= 7
                        array.set(dowLoss, dow, array.get(dowLoss, dow) + 1)
                        array.set(dowNetR, dow, array.get(dowNetR, dow) + tradeR)

    int   totalCnt = winCnt + lossCnt
    float wr       = totalCnt > 0 ? winCnt * 100.0 / totalCnt : na
    float pf       = grossLossR > 0 ? grossWinR / grossLossR : (grossWinR > 0 ? 999.0 : 0.0)
    color wrColor   = na(wr) ? lxMuted : wr >= 50 ? lxGreen : lxAmber
    color netRColor = totalCnt == 0 ? lxMuted : netR > 0 ? lxGreen : netR < 0 ? lxRed : lxAmber
    color profitCol = totalProfit > 0 ? lxGreen : totalProfit < 0 ? lxRed : lxMuted
    string netRStr  = totalCnt == 0 ? "-" : (netR > 0 ? "+" : "") + str.tostring(netR, "#.##") + "R"
    string profitStr = (totalProfit > 0 ? "+$" : totalProfit < 0 ? "-$" : "$") + str.tostring(math.abs(totalProfit), "#.##")
    string streakStr = streak > 0 ? "W" + str.tostring(streak) : streak < 0 ? "L" + str.tostring(-streak) : "-"
    color  streakColor = streak > 0 ? lxGreen : streak < 0 ? lxRed : lxMuted

    string revStr = "Break → Retest 50%"

    f_ut(tMain, 0, 0, 0, "◆   SWING_BREAK STATS", lxTitleTx, size.small, lxHeadBg)
    f_ut(tMain, 0, 0, 1, periodStr + "  ·  TP @ Swing ก่อนเกิด High/Low", lxMuted, size.tiny, lxSubBg)

    f_ut(tMain, 0, 0, 2, "Entry", lxMuted, size.tiny, lxRowA, text.align_left)
    f_ut(tMain, 0, 1, 2, revStr, lxCyan, size.small, lxRowA, text.align_right)
    f_ut(tMain, 0, 0, 3, "Break", lxMuted, size.tiny, lxRowB, text.align_left)
    f_ut(tMain, 0, 1, 3, (brkClose ? "BarClose · L" : "Intrabar · L") + str.tostring(lbL) + "/R" + str.tostring(lbR), lxCyan, size.small, lxRowB, text.align_right)
    f_ut(tMain, 0, 0, 4, "Trades", lxMuted, size.tiny, lxRowA, text.align_left)
    f_ut(tMain, 0, 1, 4, totalCnt == 0 ? "-" : str.tostring(winCnt) + "W · " + str.tostring(lossCnt) + "L", lxText, size.small, lxRowA, text.align_right)
    f_ut(tMain, 0, 0, 5, "Winrate", lxMuted, size.tiny, lxRowB, text.align_left)
    f_ut(tMain, 0, 1, 5, na(wr) ? "-" : str.tostring(wr, "#.#") + "%\n" + f_wrBar(wr), wrColor, size.small, lxRowB, text.align_right)
    f_ut(tMain, 0, 0, 13, "Net R", lxMuted, size.tiny, lxRowA, text.align_left)
    f_ut(tMain, 0, 1, 13, netRStr, netRColor, size.large, lxRowA, text.align_right)
    f_ut(tMain, 0, 0, 6, "Profit ($)", lxMuted, size.tiny, lxRowB, text.align_left)
    f_ut(tMain, 0, 1, 6, profitStr, profitCol, size.small, lxRowB, text.align_right)
    f_ut(tMain, 0, 0, 7, "Profit Factor", lxMuted, size.tiny, lxRowA, text.align_left)
    f_ut(tMain, 0, 1, 7, totalCnt == 0 ? "-" : str.tostring(pf, "#.##"), pf >= 1.5 ? lxGreen : pf >= 1.0 ? lxAmber : lxRed, size.small, lxRowA, text.align_right)
    f_ut(tMain, 0, 0, 8, "Max Streak", lxMuted, size.tiny, lxRowB, text.align_left)
    f_ut(tMain, 0, 1, 8, "W" + str.tostring(maxW) + " · L" + str.tostring(maxL), lxAmber, size.small, lxRowB, text.align_right)
    string maxWinRDate  = maxWinRStart > 0 ? "\n" + str.tostring(dayofmonth(maxWinRStart, tz)) + "/" + str.tostring(month(maxWinRStart, tz)) + "-" + str.tostring(dayofmonth(maxWinREnd, tz)) + "/" + str.tostring(month(maxWinREnd, tz)) : ""
    string maxLossRDate = maxLossRStart > 0 ? "\n" + str.tostring(dayofmonth(maxLossRStart, tz)) + "/" + str.tostring(month(maxLossRStart, tz)) + "-" + str.tostring(dayofmonth(maxLossREnd, tz)) + "/" + str.tostring(month(maxLossREnd, tz)) : ""
    f_ut(tMain, 0, 0, 9, "Max Streak R", lxMuted, size.tiny, lxRowA, text.align_left)
    f_ut(tMain, 0, 1, 9, totalCnt == 0 ? "-" : "+" + str.tostring(maxWinR, "#.##") + "R" + maxWinRDate + "\n" + str.tostring(maxLossR, "#.##") + "R" + maxLossRDate, lxAmber, size.tiny, lxRowA, text.align_right)
    f_ut(tMain, 0, 0, 10, "Max Streak Pips", lxMuted, size.tiny, lxRowB, text.align_left)
    f_ut(tMain, 0, 1, 10, totalCnt == 0 ? "-" : "+" + str.tostring(maxWinPips, "#.#") + "p · " + str.tostring(maxLossPips, "#.#") + "p", lxAmber, size.small, lxRowB, text.align_right)
    f_ut(tMain, 0, 0, 11, "Current Streak", lxMuted, size.tiny, lxRowA, text.align_left)
    f_ut(tMain, 0, 1, 11, streakStr, streakColor, size.small, lxRowA, text.align_right)
    f_ut(tMain, 0, 0, 12, "Max Drawdown", lxMuted, size.tiny, lxRowB, text.align_left)
    f_ut(tMain, 0, 1, 12, totalCnt == 0 ? "-" : "-" + str.tostring(maxDD, "#.##") + "R", maxDD > 0 ? lxRed : lxMuted, size.small, lxRowB, text.align_right)

    if not mgl1
        mgl1 := true
        f_mg(statsTable, 0, 0, 1, 0)
        f_mg(statsTable, 0, 1, 1, 1)

    // === ตารางที่ 2: WINRATE BY DAY-OF-WEEK ===
    if onDay
        f_ut(tDay, 3, 0, 0, "◆   BY DAY  ·  " + periodStr, lxTitleTx, size.small, lxHeadBg)
        f_ut(tDay, 3, 0, 1, "DAY", lxColHd, size.tiny, lxSubBg)
        f_ut(tDay, 3, 1, 1, "W-L", lxColHd, size.tiny, lxSubBg)
        f_ut(tDay, 3, 2, 1, "WR%", lxColHd, size.tiny, lxSubBg)
        f_ut(tDay, 3, 3, 1, "NET R", lxColHd, size.tiny, lxSubBg)

        array<bool> showDayArr = array.from(showMon, showTue, showWed, showThu, showFri, showSat, showSun)
        array<int>  dowIdx = array.from(2, 3, 4, 5, 6, 7, 1)
        array<string> dowNm = array.from("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
        int   bestDow = 0
        float bestNR  = 0.0
        for bd = 0 to 6
            int bDow = array.get(dowIdx, bd)
            if array.get(showDayArr, bd) and (array.get(dowWin, bDow) + array.get(dowLoss, bDow)) > 0 and array.get(dowNetR, bDow) > bestNR
                bestNR  := array.get(dowNetR, bDow)
                bestDow := bDow

        int   sumW = 0
        int   sumL = 0
        float sumR = 0.0
        int   rowIdx = 2
        for d = 0 to 6
            if array.get(showDayArr, d)
                int   dow  = array.get(dowIdx, d)
                int   dw   = array.get(dowWin,  dow)
                int   dl   = array.get(dowLoss, dow)
                float dnr  = array.get(dowNetR, dow)
                int   dtot = dw + dl
                float dwr  = dtot > 0 ? dw * 100.0 / dtot : na
                color dwrC = na(dwr) ? lxDimTx : dwr >= 50 ? lxGreen : lxAmber
                color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
                string dName = array.get(dowNm, d)
                string dwlS  = dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L"
                string dwrS  = na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%"
                string dnrS  = dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R"
                bool  isBest = dow == bestDow and dtot > 0
                color rowBg  = isBest ? lxBestBg : rowIdx % 2 == 0 ? lxRowA : lxRowB
                color dnameC = isBest ? lxTitleTx : dtot == 0 ? lxDimTx : lxText
                f_ut(tDay, 3, 0, rowIdx, (isBest ? "★ " : "") + dName, dnameC, size.small, rowBg, text.align_left)
                f_ut(tDay, 3, 1, rowIdx, dwlS, dtot == 0 ? lxDimTx : lxText, size.small, rowBg)
                f_ut(tDay, 3, 2, rowIdx, dwrS, dwrC, size.small, rowBg)
                f_ut(tDay, 3, 3, rowIdx, dnrS, dnrC, size.small, rowBg, text.align_right)
                sumW += dw
                sumL += dl
                sumR += dnr
                rowIdx += 1

        int   sumTot = sumW + sumL
        float sumWR  = sumTot > 0 ? sumW * 100.0 / sumTot : na
        f_ut(tDay, 3, 0, rowIdx, "TOTAL", lxTitleTx, size.tiny, lxHeadBg, text.align_left)
        f_ut(tDay, 3, 1, rowIdx, sumTot == 0 ? "-" : str.tostring(sumW) + "W · " + str.tostring(sumL) + "L", lxText, size.tiny, lxHeadBg)
        f_ut(tDay, 3, 2, rowIdx, na(sumWR) ? "-" : str.tostring(sumWR, "#.#") + "%", na(sumWR) ? lxDimTx : sumWR >= 50 ? lxGreen : lxAmber, size.tiny, lxHeadBg)
        f_ut(tDay, 3, 3, rowIdx, sumTot == 0 ? "-" : (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.##") + "R", sumTot == 0 ? lxDimTx : sumR > 0 ? lxGreen : lxRed, size.tiny, lxHeadBg, text.align_right)

        if not mgl2
            mgl2 := true
            f_mg(dayStatsTable, 0, 0, 3, 0)

if onMain and barstate.islast
    f_drawMain()

// ==========================================
// --- ตารางที่ 3: DAILY LOG BY DATE (Specific Month) ---
// ==========================================
f_drawDaily() =>
    var bool mgl3 = false
    array<int>    ddWin      = array.new_int(32, 0)
    array<int>    ddLoss     = array.new_int(32, 0)
    array<float>  ddNetR     = array.new_float(32, 0.0)
    array<float>  ddWinPips  = array.new_float(32, 0.0)
    array<float>  ddLossPips = array.new_float(32, 0.0)
    array<float>  ddProfit   = array.new_float(32, 0.0)

    if array.size(resIsWin) > 0
        for k = 0 to array.size(resIsWin) - 1
            int t = array.get(resTimestamp, k)
            if month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
                int   d      = dayofmonth(t, tz)
                bool  isWin  = array.get(resIsWin,   k)
                float tradeR = array.get(resTradeRR, k)
                float tpPts  = array.get(resTpPts,   k)
                if d >= 1 and d <= 31
                    if isWin
                        array.set(ddWin,  d, array.get(ddWin,  d) + 1)
                        array.set(ddWinPips, d, array.get(ddWinPips, d) + tpPts)
                    else
                        array.set(ddLoss, d, array.get(ddLoss, d) + 1)
                        array.set(ddLossPips, d, array.get(ddLossPips, d) + tpPts)
                    array.set(ddNetR, d, array.get(ddNetR, d) + tradeR)
                    array.set(ddProfit, d, array.get(ddProfit, d) + array.get(resProfit, k))

    f_ut(tDaily, 4, 0, 0, "◆   DAILY LOG  ·  " + (statMode == "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)" ? str.format_time(selToTime, "MMM", tz) : statTargetM) + " " + str.tostring(actualTargetY), lxTitleTx, size.small, lxHeadBg)
    f_ut(tDaily, 4, 0, 1, "DATE", lxColHd, size.tiny, lxSubBg)
    f_ut(tDaily, 4, 1, 1, "W-L", lxColHd, size.tiny, lxSubBg)
    f_ut(tDaily, 4, 2, 1, "WR%", lxColHd, size.tiny, lxSubBg)
    f_ut(tDaily, 4, 5, 1, "NET R", lxColHd, size.tiny, lxSubBg)
    f_ut(tDaily, 4, 3, 1, "PIPS", lxColHd, size.tiny, lxSubBg)
    f_ut(tDaily, 4, 4, 1, "PROFIT $", lxColHd, size.tiny, lxSubBg)

    int   totW = 0
    int   totL = 0
    float totR = 0.0
    float totProf = 0.0
    float totWinPips  = 0.0
    float totLossPips = 0.0
    for d = 1 to 31
        int   dw   = array.get(ddWin,  d)
        int   dl   = array.get(ddLoss, d)
        float dnr  = array.get(ddNetR, d)
        float dwp  = array.get(ddWinPips,  d)
        float dlp  = array.get(ddLossPips, d)
        int   dtot = dw + dl
        float dwr  = dtot > 0 ? dw * 100.0 / dtot : na
        color dwrC = na(dwr) ? lxDimTx : dwr >= 50.0 ? lxGreen : lxAmber
        color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
        string dwlS  = dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L"
        string dwrS  = na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%"
        string dnrS  = dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R"
        string dpipS = dtot == 0 ? "-" : "+" + str.tostring(dwp, "#.#") + " / -" + str.tostring(dlp, "#.#")
        color  dpipC = dtot == 0 ? lxDimTx : (dwp - dlp) > 0 ? lxGreen : (dwp - dlp) < 0 ? lxRed : lxAmber
        float dprof = array.get(ddProfit, d)
        color dayBg = dtot == 0 ? lxRowDim : d % 2 == 1 ? lxRowA : lxRowB
        color dateC = dtot == 0 ? lxDimTx : lxText
        f_ut(tDaily, 4, 0, d + 1, str.tostring(d), dateC, size.tiny, dayBg)
        f_ut(tDaily, 4, 1, d + 1, dwlS, dateC, size.tiny, dayBg)
        f_ut(tDaily, 4, 2, d + 1, dwrS, dwrC, size.tiny, dayBg)
        f_ut(tDaily, 4, 5, d + 1, dnrS, dnrC, size.tiny, dayBg, text.align_right)
        f_ut(tDaily, 4, 3, d + 1, dpipS, dpipC, size.tiny, dayBg, text.align_right)
        f_ut(tDaily, 4, 4, d + 1, dtot == 0 ? "-" : (dprof >= 0 ? "+$" : "-$") + str.tostring(math.abs(dprof), "#.##"), dtot == 0 ? lxDimTx : dprof > 0 ? lxGreen : dprof < 0 ? lxRed : lxAmber, size.tiny, dayBg, text.align_right)
        totW += dw
        totL += dl
        totR += dnr
        totProf += dprof
        totWinPips  += dwp
        totLossPips += dlp

    int   totTot = totW + totL
    float totWR  = totTot > 0 ? totW * 100.0 / totTot : na
    color totWRC = na(totWR) ? lxDimTx : totWR >= 50 ? lxGreen : lxAmber
    color totNRC = totTot == 0 ? lxDimTx : totR > 0 ? lxGreen : totR < 0 ? lxRed : lxAmber
    string totWLS = totTot == 0 ? "-" : str.tostring(totW) + "W · " + str.tostring(totL) + "L"
    string totWRS = na(totWR) ? "-" : str.tostring(totWR, "#.#") + "%"
    string totNRS = totTot == 0 ? "-" : (totR >= 0 ? "+" : "") + str.tostring(totR, "#.##") + "R"
    string totPipS = totTot == 0 ? "-" : "+" + str.tostring(totWinPips, "#.#") + " / -" + str.tostring(totLossPips, "#.#")
    color  totPipC = totTot == 0 ? lxDimTx : (totWinPips - totLossPips) > 0 ? lxGreen : lxRed
    f_ut(tDaily, 4, 0, 33, "TOTAL", lxTitleTx, size.tiny, lxHeadBg, text.align_left)
    f_ut(tDaily, 4, 1, 33, totWLS, lxText, size.tiny, lxHeadBg)
    f_ut(tDaily, 4, 2, 33, totWRS, totWRC, size.tiny, lxHeadBg)
    f_ut(tDaily, 4, 5, 33, totNRS, totNRC, size.tiny, lxHeadBg, text.align_right)
    f_ut(tDaily, 4, 3, 33, totPipS, totPipC, size.tiny, lxHeadBg, text.align_right)
    f_ut(tDaily, 4, 4, 33, totTot == 0 ? "-" : (totProf >= 0 ? "+$" : "-$") + str.tostring(math.abs(totProf), "#.##"), f_posColor(totProf, totTot == 0), size.tiny, lxHeadBg, text.align_left)

    if not mgl3
        mgl3 := true
        f_mg(dailyStatsTable, 0, 0, 5, 0)

if onDaily and barstate.islast
    f_drawDaily()

// ==========================================
// --- ตารางที่ 4: MONTHLY STATS ---
// ==========================================
f_drawMonthly() =>
    var bool mgl4 = false
    int startTotalM = currentTotalM - statMonths + 1
    array<int>   mWin    = array.new_int(statMonths, 0)
    array<int>   mLoss   = array.new_int(statMonths, 0)
    array<float> mNetR   = array.new_float(statMonths, 0.0)
    array<int>   mMaxW   = array.new_int(statMonths, 0)
    array<int>   mMaxL   = array.new_int(statMonths, 0)
    array<int>   mStreak = array.new_int(statMonths, 0)

    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTimestamp, i)
            int tTotalM = year(t, tz) * 12 + month(t, tz)
            int idx = tTotalM - startTotalM
            if idx >= 0 and idx < statMonths
                float tradeR = array.get(resTradeRR, i)
                bool isWin = array.get(resIsWin, i)
                int curStrk = array.get(mStreak, idx)
                if isWin
                    array.set(mWin, idx, array.get(mWin, idx) + 1)
                    curStrk := curStrk >= 0 ? curStrk + 1 : 1
                    array.set(mMaxW, idx, math.max(array.get(mMaxW, idx), curStrk))
                else
                    array.set(mLoss, idx, array.get(mLoss, idx) + 1)
                    curStrk := curStrk <= 0 ? curStrk - 1 : -1
                    array.set(mMaxL, idx, math.max(array.get(mMaxL, idx), -curStrk))
                array.set(mStreak, idx, curStrk)
                array.set(mNetR, idx, array.get(mNetR, idx) + tradeR)

    f_ut(tMon, 5, 0, 0, "◆   MONTHLY  ·  Last " + str.tostring(statMonths) + " Months", lxTitleTx, size.small, lxHeadBg)
    f_ut(tMon, 5, 0, 1, "MONTH", lxColHd, size.tiny, lxSubBg)
    f_ut(tMon, 5, 1, 1, "W-L", lxColHd, size.tiny, lxSubBg)
    f_ut(tMon, 5, 2, 1, "WR%", lxColHd, size.tiny, lxSubBg)
    f_ut(tMon, 5, 4, 1, "NET R", lxColHd, size.tiny, lxSubBg)
    f_ut(tMon, 5, 3, 1, "STREAK", lxColHd, size.tiny, lxSubBg)

    int bestMIdx = -1
    float bestMNR = 0.0
    for m = 0 to statMonths - 1
        if (array.get(mWin, m) + array.get(mLoss, m)) > 0 and array.get(mNetR, m) > bestMNR
            bestMNR := array.get(mNetR, m)
            bestMIdx := m

    int mSumW = 0
    int mSumL = 0
    float mSumR = 0.0
    for m = 0 to statMonths - 1
        int totalM = startTotalM + m
        int mMon = (totalM - 1) % 12 + 1
        int mYr  = math.round((totalM - mMon) / 12)
        string mLabel = f_monthShort(mMon) + " " + str.tostring(mYr)

        int mw = array.get(mWin, m)
        int ml = array.get(mLoss, m)
        float mnr = array.get(mNetR, m)
        int mtot = mw + ml
        float mwr = mtot > 0 ? mw * 100.0 / mtot : na
        color mwrC = na(mwr) ? lxDimTx : mwr >= 50 ? lxGreen : lxAmber
        color mnrC = mtot == 0 ? lxDimTx : mnr > 0 ? lxGreen : mnr < 0 ? lxRed : lxAmber
        string mwlS = mtot == 0 ? "-" : str.tostring(mw) + "W · " + str.tostring(ml) + "L"
        string mwrS = na(mwr) ? "-" : str.tostring(mwr, "#.#") + "%"
        string mnrS = mtot == 0 ? "-" : (mnr >= 0 ? "+" : "") + str.tostring(mnr, "#.##") + "R"
        bool isBestM = m == bestMIdx and mtot > 0
        color mRowBg = isBestM ? lxBestBg : m % 2 == 0 ? lxRowA : lxRowB
        color mLabelC = isBestM ? lxTitleTx : mtot == 0 ? lxDimTx : lxText
        int mmxW = array.get(mMaxW, m)
        int mmxL = array.get(mMaxL, m)
        string mStrkS = mtot == 0 ? "-" : "W" + str.tostring(mmxW) + " · L" + str.tostring(mmxL)

        f_ut(tMon, 5, 0, m + 2, (isBestM ? "★ " : "") + mLabel, mLabelC, size.small, mRowBg, text.align_left)
        f_ut(tMon, 5, 1, m + 2, mwlS, mtot == 0 ? lxDimTx : lxText, size.small, mRowBg)
        f_ut(tMon, 5, 2, m + 2, mwrS, mwrC, size.small, mRowBg)
        f_ut(tMon, 5, 4, m + 2, mnrS, mnrC, size.small, mRowBg, text.align_right)
        f_ut(tMon, 5, 3, m + 2, mStrkS, mtot == 0 ? lxDimTx : lxAmber, size.small, mRowBg)

        mSumW += mw
        mSumL += ml
        mSumR += mnr

    int mSumTot = mSumW + mSumL
    float mSumWR = mSumTot > 0 ? mSumW * 100.0 / mSumTot : na
    color mSumWRC = na(mSumWR) ? lxDimTx : mSumWR >= 50 ? lxGreen : lxAmber
    color mSumNRC = mSumTot == 0 ? lxDimTx : mSumR > 0 ? lxGreen : mSumR < 0 ? lxRed : lxAmber
    string mSumWLS = mSumTot == 0 ? "-" : str.tostring(mSumW) + "W · " + str.tostring(mSumL) + "L"
    string mSumWRS = na(mSumWR) ? "-" : str.tostring(mSumWR, "#.#") + "%"
    string mSumNRS = mSumTot == 0 ? "-" : (mSumR >= 0 ? "+" : "") + str.tostring(mSumR, "#.##") + "R"

    int totalRow = statMonths + 2
    int allMaxW = 0
    int allMaxL = 0
    for sm = 0 to statMonths - 1
        allMaxW := math.max(allMaxW, array.get(mMaxW, sm))
        allMaxL := math.max(allMaxL, array.get(mMaxL, sm))
    string allStrkS = mSumTot == 0 ? "-" : "W" + str.tostring(allMaxW) + " · L" + str.tostring(allMaxL)

    f_ut(tMon, 5, 0, totalRow, "TOTAL", lxTitleTx, size.tiny, lxHeadBg, text.align_left)
    f_ut(tMon, 5, 1, totalRow, mSumWLS, lxText, size.tiny, lxHeadBg)
    f_ut(tMon, 5, 2, totalRow, mSumWRS, mSumWRC, size.tiny, lxHeadBg)
    f_ut(tMon, 5, 4, totalRow, mSumNRS, mSumNRC, size.tiny, lxHeadBg, text.align_right)
    f_ut(tMon, 5, 3, totalRow, allStrkS, mSumTot == 0 ? lxDimTx : lxAmber, size.tiny, lxHeadBg)

    if not mgl4
        mgl4 := true
        f_mg(monthlyStatsTable, 0, 0, 4, 0)

if onMon and barstate.islast
    f_drawMonthly()

// ==========================================
// --- ตารางที่ 5: SETTINGS SUMMARY ---
// ==========================================
// ==========================================
// --- ตาราง: BY DIRECTION (แยกสถิติ BUY / SELL) ---
// ==========================================
f_drawEntry() =>
    // ต่อฝั่ง g (0 = BUY, 1 = SELL): [w, l, ΣR ชนะ, ΣR แพ้, Σจุด]
    array<float> ea = array.new_float(10, 0.0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            if f_inStatPeriod(array.get(resTimestamp, i))
                int b = (array.get(resBuy, i) ? 0 : 1) * 5
                float r = array.get(resTradeRR, i)
                if array.get(resIsWin, i)
                    array.set(ea, b, array.get(ea, b) + 1)
                    array.set(ea, b + 2, array.get(ea, b + 2) + r)
                else
                    array.set(ea, b + 1, array.get(ea, b + 1) + 1)
                    array.set(ea, b + 3, array.get(ea, b + 3) + r)
                array.set(ea, b + 4, array.get(ea, b + 4) + array.get(resTpPts, i))
    f_ut(tEnt, 6, 0, 0, "◆ BY DIRECTION (BUY / SELL)", lxTitleTx, size.small, lxHeadBg, text.align_left)
    for c = 1 to 7
        f_ut(tEnt, 6, c, 0, "", lxTitleTx, size.tiny, lxHeadBg)
    array<string> hd = array.from("SIDE", "W-L", "WR%", "AVG R", "+R", "-R", "PF", "NET R")
    for c = 0 to 7
        f_ut(tEnt, 6, c, 1, array.get(hd, c), lxColHd, size.tiny, lxSubBg, c == 0 ? text.align_left : text.align_center)
    array<string> gNames = array.from("▲ BUY", "▼ SELL")
    int sumW = 0
    int sumL = 0
    float sumWinR = 0.0
    float sumLossR = 0.0
    for g = 0 to 1
        int b = g * 5
        int w = int(array.get(ea, b))
        int l = int(array.get(ea, b + 1))
        float wR = array.get(ea, b + 2)
        float lR = array.get(ea, b + 3)
        int tot = w + l
        float nr = wR + lR
        float wr = tot > 0 ? w * 100.0 / tot : na
        color bg = g % 2 == 0 ? lxRowA : lxRowB
        color rc = f_posColor(nr, tot == 0)
        int row = g + 2
        f_ut(tEnt, 6, 0, row, array.get(gNames, g), tot == 0 ? lxDimTx : lxText, size.tiny, bg, text.align_left)
        f_ut(tEnt, 6, 1, row, tot == 0 ? "-" : str.tostring(w) + "W·" + str.tostring(l) + "L", tot == 0 ? lxDimTx : lxText, size.tiny, bg)
        f_ut(tEnt, 6, 2, row, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", na(wr) ? lxDimTx : wr >= 50 ? lxGreen : lxAmber, size.tiny, bg)
        f_ut(tEnt, 6, 7, row, tot == 0 ? "-" : f_rStr(nr), rc, size.tiny, bg, text.align_right)
        f_ut(tEnt, 6, 3, row, tot == 0 ? "-" : f_rStr(nr / tot), rc, size.tiny, bg, text.align_right)
        f_ut(tEnt, 6, 4, row, w == 0 ? "-" : "+" + str.tostring(wR, "#.##") + "R", w == 0 ? lxDimTx : lxGreen, size.tiny, bg, text.align_right)
        f_ut(tEnt, 6, 5, row, l == 0 ? "-" : str.tostring(lR, "#.##") + "R", l == 0 ? lxDimTx : lxRed, size.tiny, bg, text.align_right)
        f_ut(tEnt, 6, 6, row, tot == 0 ? "-" : lR < 0 ? str.tostring(wR / -lR, "#.##") : "∞", lxAmber, size.tiny, bg)
        sumW += w
        sumL += l
        sumWinR += wR
        sumLossR += lR
    int sumTot = sumW + sumL
    float sumNr = sumWinR + sumLossR
    f_ut(tEnt, 6, 0, 4, "TOTAL", lxTitleTx, size.tiny, lxHeadBg, text.align_left)
    f_ut(tEnt, 6, 1, 4, sumTot == 0 ? "-" : str.tostring(sumW) + "W·" + str.tostring(sumL) + "L", lxText, size.tiny, lxHeadBg)
    f_ut(tEnt, 6, 2, 4, sumTot == 0 ? "-" : str.tostring(sumW * 100.0 / sumTot, "#.#") + "%", lxText, size.tiny, lxHeadBg)
    f_ut(tEnt, 6, 7, 4, sumTot == 0 ? "-" : f_rStr(sumNr), f_posColor(sumNr, sumTot == 0), size.tiny, lxHeadBg, text.align_right)
    f_ut(tEnt, 6, 3, 4, sumTot == 0 ? "-" : f_rStr(sumNr / sumTot), f_posColor(sumNr, sumTot == 0), size.tiny, lxHeadBg, text.align_right)
    f_ut(tEnt, 6, 4, 4, sumW == 0 ? "-" : "+" + str.tostring(sumWinR, "#.##") + "R", lxGreen, size.tiny, lxHeadBg, text.align_right)
    f_ut(tEnt, 6, 5, 4, sumL == 0 ? "-" : str.tostring(sumLossR, "#.##") + "R", lxRed, size.tiny, lxHeadBg, text.align_right)
    f_ut(tEnt, 6, 6, 4, sumTot == 0 ? "-" : sumLossR < 0 ? str.tostring(sumWinR / -sumLossR, "#.##") : "∞", lxAmber, size.tiny, lxHeadBg)

// ==========================================
// --- ตาราง: SELECTED DATE (สรุปเฉพาะวัน/ช่วงวันที่ที่เลือก ไม่แยกออเดอร์) ---
// ==========================================
f_drawDate() =>
    int   dW = 0
    int   dL = 0
    float dWinR = 0.0
    float dLossR = 0.0
    float dProf = 0.0
    float dBest = na
    float dWorst = na
    array<float> la = array.new_float(16, 0.0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int tt = array.get(resTimestamp, i)
            int tid = year(tt, tz) * 10000 + month(tt, tz) * 100 + dayofmonth(tt, tz)
            if tid >= selFromId and tid <= selToId
                float r = array.get(resTradeRR, i)
                int lv = array.get(resBuy, i) ? 0 : 1
                dProf += array.get(resProfit, i)
                dBest := na(dBest) ? r : math.max(dBest, r)
                dWorst := na(dWorst) ? r : math.min(dWorst, r)
                if array.get(resIsWin, i)
                    dW += 1
                    dWinR += r
                    if lv < 4
                        array.set(la, lv * 4, array.get(la, lv * 4) + 1)
                else
                    dL += 1
                    dLossR += r
                    if lv < 4
                        array.set(la, lv * 4 + 1, array.get(la, lv * 4 + 1) + 1)
                if lv < 4
                    array.set(la, lv * 4 + 2, array.get(la, lv * 4 + 2) + r)
    int   dTot = dW + dL
    float dNet = dWinR + dLossR
    float dWr  = dTot > 0 ? dW * 100.0 / dTot : na
    string dRange = selFromId == selToId ? str.format_time(selFromTime, "dd/MM/yy", tz) : str.format_time(selFromTime, "dd/MM/yy", tz) + " – " + str.format_time(selToTime, "dd/MM/yy", tz)
    f_ut(tDate, 1, 0, 0, "◆ SELECTED DATE  ·  " + dRange, lxTitleTx, size.small, lxHeadBg, text.align_left)
    f_ut(tDate, 1, 1, 0, "", lxTitleTx, size.tiny, lxHeadBg, text.align_right)
    array<string> dl = array.from("Orders (W·L)", "Winrate", "Profit ($)", "+R / -R", "Profit Factor", "Avg R / order", "Best / Worst")
    array<string> dv = array.from(
         dTot == 0 ? "-" : str.tostring(dW) + "W · " + str.tostring(dL) + "L  (" + str.tostring(dTot) + ")",
         na(dWr) ? "-" : str.tostring(dWr, "#.#") + "%",
         dTot == 0 ? "-" : (dProf >= 0 ? "+$" : "-$") + str.tostring(math.abs(dProf), "#.##"),
         dTot == 0 ? "-" : "+" + str.tostring(dWinR, "#.##") + "R / " + str.tostring(dLossR, "#.##") + "R",
         dTot == 0 ? "-" : dLossR < 0 ? str.tostring(dWinR / -dLossR, "#.##") : "∞",
         dTot == 0 ? "-" : f_rStr(dNet / dTot),
         dTot == 0 ? "-" : f_rStr(dBest) + " / " + f_rStr(dWorst))
    array<color> dc = array.from(lxText, na(dWr) ? lxDimTx : dWr >= 50 ? lxGreen : lxAmber, f_posColor(dProf, dTot == 0), lxText, lxAmber, f_posColor(dNet, dTot == 0), lxText)
    for k = 0 to 6
        color bg = k % 2 == 0 ? lxRowA : lxRowB
        f_ut(tDate, 1, 0, k + 1, array.get(dl, k), lxMuted, size.tiny, bg, text.align_left)
        f_ut(tDate, 1, 1, k + 1, array.get(dv, k), array.get(dc, k), size.small, bg, text.align_right)
    // ต่อฝั่ง BUY / SELL (รวมทุกไม้ของฝั่งนั้นในช่วงที่เลือก)
    for g = 0 to 1
        float gw = array.get(la, g * 4)
        float gl = array.get(la, g * 4 + 1)
        float gr = array.get(la, g * 4 + 2)
        color bg = g % 2 == 0 ? lxRowB : lxRowA
        f_ut(tDate, 1, 0, 8 + g, g == 0 ? "▲ BUY" : "▼ SELL", lxMuted, size.tiny, bg, text.align_left)
        f_ut(tDate, 1, 1, 8 + g, gw + gl == 0 ? "-" : str.tostring(gw, "#") + "W · " + str.tostring(gl, "#") + "L  " + f_rStr(gr), gw + gl == 0 ? lxDimTx : f_posColor(gr, false), size.tiny, bg, text.align_right)

    f_ut(tDate, 1, 0, 12, "NET R", lxTitleTx, size.small, lxHeadBg, text.align_left)
    f_ut(tDate, 1, 1, 12, dTot == 0 ? "-" : f_rStr(dNet), f_posColor(dNet, dTot == 0), size.large, lxHeadBg, text.align_right)

if onDate and barstate.islast
    f_drawDate()

// ==========================================
// --- ตาราง: PERFORMANCE (Equity Curve จากเทรดที่ปิดในช่วงสถิติ + Net Profit / Max Drawdown / Profit Factor) ---
// ==========================================
f_drawPerf() =>
    var bool mglP = false
    int   PW = 12
    int   PH = 8
    array<float> eq = array.new_float(1, 0.0)
    float gW = 0.0
    float gL = 0.0
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            if f_inStatPeriod(array.get(resTimestamp, i))
                float pf = array.get(resProfit, i)
                array.push(eq, array.get(eq, array.size(eq) - 1) + pf)
                if pf > 0
                    gW += pf
                else
                    gL += -pf
    int   nEq = array.size(eq) - 1
    float eqNet = array.get(eq, nEq)
    float eqPeak = 0.0
    float eqDD = 0.0
    float eqMin = 0.0
    float eqMax = 0.0
    for i = 0 to nEq
        float v = array.get(eq, i)
        eqPeak := math.max(eqPeak, v)
        eqDD := math.max(eqDD, eqPeak - v)
        eqMin := math.min(eqMin, v)
        eqMax := math.max(eqMax, v)
    float eqRng = math.max(eqMax - eqMin, 0.000001)
    color lineCol = eqNet >= 0 ? lxGreen : lxRed
    f_ut(tPerf, 7, 0, 0, "◆ PERFORMANCE · Equity Curve   " + periodStr + "   (" + str.tostring(nEq) + " orders)", lxTitleTx, size.small, lxHeadBg, text.align_left)
    for c = 1 to PW + 3
        table.cell(tPerf, f_uc(7, c, 0), f_ur(7, c, 0), "", text_size=size.tiny, bgcolor=lxHeadBg, text_font_family=tblFont)
    // กราฟ: คอลัมน์ x = ความคืบหน้าของเทรด, แถว = ระดับ equity (เส้น = เซลล์สี, ใต้เส้น = สีจาง)
    array<int> rowAt = array.new_int(PW, 0)
    for x = 0 to PW - 1
        int idx = nEq == 0 ? 0 : math.round(x * nEq / (PW - 1.0))
        array.set(rowAt, x, math.round((array.get(eq, idx) - eqMin) / eqRng * (PH - 1)))
    int zeroRow = math.round((0 - eqMin) / eqRng * (PH - 1))
    for x = 0 to PW - 1
        for rr = 0 to PH - 1
            int lvlRow = PH - 1 - rr
            bool onLine = array.get(rowAt, x) == lvlRow
            bool below = lvlRow < array.get(rowAt, x)
            color cc = onLine ? lineCol : below ? color.new(lineCol, 80) : lvlRow == zeroRow ? color.new(lxMuted, 70) : lxRowA
            table.cell(tPerf, f_uc(7, x, rr + 1), f_ur(7, x, rr + 1), "", text_size=size.tiny, bgcolor=cc, width=0.55, height=1.1, text_font_family=tblFont)
    // KPI การ์ดทางขวา
    string netS = nEq == 0 ? "-" : (eqNet >= 0 ? "+$" : "-$") + str.tostring(math.abs(eqNet), "#.##") + (perfAccount > 0 ? "  (" + (eqNet >= 0 ? "+" : "") + str.tostring(eqNet / perfAccount * 100, "#.##") + "%)" : "")
    string ddS  = nEq == 0 ? "-" : "-$" + str.tostring(eqDD, "#.##") + (perfAccount > 0 ? "  (-" + str.tostring(eqDD / perfAccount * 100, "#.##") + "%)" : "")
    string pfS  = nEq == 0 ? "-" : gL > 0 ? str.tostring(gW / gL, "#.##") : "∞"
    f_ut(tPerf, 7, PW, 7, "Net Profit:\n" + netS, f_posColor(eqNet, nEq == 0), size.small, lxRowB, text.align_left)
    f_ut(tPerf, 7, PW, 1, "Max Drawdown:\n" + ddS, eqDD > 0 ? lxRed : lxMuted, size.small, lxRowA, text.align_left)
    f_ut(tPerf, 7, PW, 4, "Profit Factor:\n" + pfS, nEq == 0 ? lxDimTx : gL == 0 or gW / gL >= 1.5 ? lxGreen : gW / gL >= 1.0 ? lxAmber : lxRed, size.small, lxRowB, text.align_left)
    if not mglP
        mglP := true
        f_mg(perfTbl, 0, 0, PW + 3, 0)
        f_mg(perfTbl, PW, 1, PW + 3, 3)
        f_mg(perfTbl, PW, 4, PW + 3, 6)
        f_mg(perfTbl, PW, 7, PW + 3, 8)

if onPerf and barstate.islast
    f_drawPerf()

f_drawSettings() =>
    if not uniMode
        table.clear(settingsTable, 0, 0, 1, 29)
    int rowIdx = 0
    f_ut(tSet, 2, 0, rowIdx, "◆   SETTINGS SUMMARY", lxTitleTx, size.small, lxHeadBg)
    f_ut(tSet, 2, 1, rowIdx, "", lxTitleTx, size.small, lxHeadBg)
    rowIdx += 1

    f_ut(tSet, 2, 0, rowIdx, "─── Entry ───", lxColHd, size.tiny, lxSubBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, "", lxColHd, size.tiny, lxSubBg)
    rowIdx += 1
    color rowBg = rowIdx % 2 == 1 ? lxRowA : lxRowB
    f_ut(tSet, 2, 0, rowIdx, "Swing Break", lxMuted, size.tiny, rowBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, "Pivot L" + str.tostring(lbL) + " / R" + str.tostring(lbR), lxCyan, size.tiny, rowBg, text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    string tdTxt = (tradeMon ? "Mo " : "") + (tradeTue ? "Tu " : "") + (tradeWed ? "We " : "") + (tradeThu ? "Th " : "") + (tradeFri ? "Fr " : "") + (tradeSat ? "Sa " : "") + (tradeSun ? "Su" : "")
    f_ut(tSet, 2, 0, rowIdx, "Trade days", lxMuted, size.tiny, rowBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, tdTxt, lxCyan, size.tiny, rowBg, text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    f_ut(tSet, 2, 0, rowIdx, "Break condition", lxMuted, size.tiny, rowBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, (brkClose ? "รอแท่งปิด" : "ทันทีที่ราคาทะลุ"), lxCyan, size.tiny, rowBg, text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    f_ut(tSet, 2, 0, rowIdx, "SL % / TP", lxMuted, size.tiny, rowBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, str.tostring(slPct, "#.##") + "% / Swing ก่อนหน้า", lxCyan, size.tiny, rowBg, text.align_right)
    rowIdx += 1

    f_ut(tSet, 2, 0, rowIdx, "─── Risk ───", lxColHd, size.tiny, lxSubBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, "", lxColHd, size.tiny, lxSubBg)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    f_ut(tSet, 2, 0, rowIdx, "Risk / Trade", lxMuted, size.tiny, rowBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, "$" + str.tostring(riskAmount, "#.##"), lxText, size.tiny, rowBg, text.align_right)
    rowIdx += 1

    f_ut(tSet, 2, 0, rowIdx, "─── Period ───", lxColHd, size.tiny, lxSubBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, "", lxColHd, size.tiny, lxSubBg)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    f_ut(tSet, 2, 0, rowIdx, "Stat Range", lxMuted, size.tiny, rowBg, text.align_left)
    f_ut(tSet, 2, 1, rowIdx, periodStr, lxText, size.tiny, rowBg, text.align_right)

if onSet and barstate.islast
    f_drawSettings()

// ==========================================
// --- ตารางรวม (All-in-one): หัวตาราง + รวมเซลล์ (merge) ตามผังของแต่ละส่วน ทำครั้งเดียว ---
// ==========================================
f_mFull(int _r) =>
    table.merge_cells(uniTbl, 0, _r, 15, _r)

f_mSpans(array<int> _sp, int _r) =>
    for k = 0 to array.size(_sp) - 1
        int _w = array.get(_sp, k)
        if _w > 1
            int _st = f_start(_sp, k)
            table.merge_cells(uniTbl, _st, _r, _st + _w - 1, _r)

f_mPair(int _r) =>
    for pc = 0 to 1
        table.merge_cells(uniTbl, pc * 8, _r, pc * 8 + 3, _r)
        table.merge_cells(uniTbl, pc * 8 + 4, _r, pc * 8 + 7, _r)

f_drawUni() =>
    var bool mglU = false
    f_tc(uniTbl, 0, 0, "◆ SWING_BREAK   ·   " + periodStr, lxTitleTx, size.small, lxHeadBg, text.align_left)
    if not mglU
        mglU := true
        f_mFull(0)
        if onGame and showCrypto
            f_mFull(offGame + (showPacman ? 1 : 0))
        if onScore
            f_mSpans(spScore, offScore)
            f_mSpans(spScore, offScore + 1)
        if onPerf
            f_mFull(offPerf)
            table.merge_cells(uniTbl, 12, offPerf + 1, 15, offPerf + 3)
            table.merge_cells(uniTbl, 12, offPerf + 4, 15, offPerf + 6)
            table.merge_cells(uniTbl, 12, offPerf + 7, 15, offPerf + 8)
        if onMain
            f_mFull(offMain)
            f_mFull(offMain + 1)
            for r = offMain + 2 to offMain + rowsMain - 1
                f_mPair(r)
        if onDate
            f_mFull(offDate)
            for r = offDate + 1 to offDate + rowsDate - 1
                f_mPair(r)
        if onEnt
            f_mFull(offEnt)
            for r = offEnt + 1 to offEnt + rowsEnt - 1
                f_mSpans(spEnt, r)
        if onDay
            f_mFull(offDay)
            for r = offDay + 1 to offDay + rowsDay - 1
                f_mSpans(spDay, r)
        if onMon
            f_mFull(offMon)
            for r = offMon + 1 to offMon + rowsMon - 1
                f_mSpans(spMon, r)
        if onDaily
            f_mFull(offDaily)
            for r = offDaily + 1 to offDaily + rowsDaily - 1
                f_mSpans(spDaily, r)
        if onSet
            f_mFull(offSet)
            for r = offSet + 1 to offSet + rowsSet - 1
                f_mPair(r)

if uniMode and statsOn and barstate.islast
    f_drawUni()


// ==========================================
// --- DASHBOARD แยกต่างหาก (แรงบันดาลใจ: แดชบอร์ด EA บน MT5) ---
// ==========================================
f_money(float _x) =>
    (_x >= 0 ? "+" : "-") + str.tostring(math.abs(_x), "#.#")

f_drawDash() =>
    var bool mgd = false
    int calY = year(selToTime, tz)
    int calM = month(selToTime, tz)
    array<float> dP = array.new_float(32, 0.0)
    array<int>   dN = array.new_int(32, 0)
    array<float> mP = array.new_float(13, 0.0)
    array<float> hP = array.new_float(24, 0.0)
    array<float> eq = array.from(0.0)
    float gW = 0.0
    float gL = 0.0
    int   nT = 0
    int   nW = 0
    float maxLoss = 0.0
    float bestT = 0.0
    int   curLS = 0
    int   maxLS = 0
    int   monthsSeen = 0
    int   lastMid = 0
    float sumWinR = 0.0
    float sumLossR = 0.0
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTimestamp, i)
            float pf = array.get(resProfit, i)
            bool win = array.get(resIsWin, i)
            if year(t, tz) == calY
                array.set(mP, month(t, tz), array.get(mP, month(t, tz)) + pf)
                if month(t, tz) == calM
                    int dd = dayofmonth(t, tz)
                    array.set(dP, dd, array.get(dP, dd) + pf)
                    array.set(dN, dd, array.get(dN, dd) + 1)
            if f_inStatPeriod(t)
                nT += 1
                int hh = hour(t, tz)
                array.set(hP, hh, array.get(hP, hh) + pf)
                array.push(eq, array.get(eq, array.size(eq) - 1) + pf)
                int mid = year(t, tz) * 12 + month(t, tz)
                if mid != lastMid
                    lastMid := mid
                    monthsSeen += 1
                if win
                    nW += 1
                    gW += pf
                    curLS := 0
                    bestT := math.max(bestT, pf)
                    sumWinR += array.get(resTradeRR, i)
                else
                    gL += -pf
                    curLS += 1
                    maxLS := math.max(maxLS, curLS)
                    maxLoss := math.min(maxLoss, pf)
                    sumLossR += array.get(resTradeRR, i)
    int   nEq = array.size(eq) - 1
    float net = array.get(eq, nEq)
    float peak = 0.0
    float ddMax = 0.0
    float eMin = 0.0
    float eMax = 0.0
    for k = 0 to nEq
        float v = array.get(eq, k)
        peak := math.max(peak, v)
        ddMax := math.max(ddMax, peak - v)
        eMin := math.min(eMin, v)
        eMax := math.max(eMax, v)
    float eRng = math.max(eMax - eMin, 0.000001)
    color upC = lxGreen
    color dnC = lxRed
    // ---------- หัวตาราง ----------
    f_tc(dashTbl, 0, 0, "◆ DASHBOARD  ·  SWING_BREAK  ·  " + periodStr + "  ·  " + str.tostring(nT) + " orders", lxTitleTx, size.normal, lxHeadBg, text.align_left)
    // ---------- KPI การ์ด 7 ใบ ----------
    array<string> kl = array.from("NET PROFIT ($)", "ROI", "MAX DRAWDOWN", "PROFIT FACTOR", "WIN RATE", "RECOVERY", "AVG / MONTH")
    float pfv = gL > 0 ? gW / gL : na
    array<string> kv = array.from(
         nT == 0 ? "-" : f_money(net),
         nT == 0 or perfAccount <= 0 ? "-" : f_money(net / perfAccount * 100.0) + "%",
         nT == 0 ? "-" : "-" + str.tostring(ddMax, "#.#") + (perfAccount > 0 ? " (" + str.tostring(ddMax / perfAccount * 100.0, "#.#") + "%)" : ""),
         nT == 0 ? "-" : na(pfv) ? "∞" : str.tostring(pfv, "#.##"),
         nT == 0 ? "-" : str.tostring(nW * 100.0 / nT, "#.#") + "%",
         nT == 0 ? "-" : ddMax > 0 ? str.tostring(net / ddMax, "#.##") : "∞",
         nT == 0 ? "-" : f_money(net / math.max(monthsSeen, 1)))
    array<color> kc = array.from(f_posColor(net, nT == 0), f_posColor(net, nT == 0), nT == 0 ? lxDimTx : lxRed, nT == 0 ? lxDimTx : na(pfv) or pfv >= 1.5 ? lxGreen : pfv >= 1.0 ? lxAmber : lxRed, nT == 0 ? lxDimTx : nW * 100.0 / nT >= 50 ? lxGreen : lxAmber, nT == 0 ? lxDimTx : net > 0 ? lxGreen : lxRed, f_posColor(net, nT == 0))
    for k = 0 to 6
        f_tc(dashTbl, k * 4, 1, array.get(kl, k), lxMuted, size.tiny, lxRowB, text.align_left)
        f_tc(dashTbl, k * 4, 2, array.get(kv, k), array.get(kc, k), size.large, lxRowB, text.align_left)
    // ---------- ปฏิทินกำไรรายวัน (ซ้าย) ----------
    string monNm = str.format_time(timestamp(tz, calY, calM, 1, 12, 0), "MMM yyyy", tz)
    f_tc(dashTbl, 0, 3, "ปฏิทินกำไรรายวัน · " + monNm, lxTitleTx, size.small, lxHeadBg, text.align_left)
    f_tc(dashTbl, 14, 3, "Equity Curve ($)  " + (nT == 0 ? "" : f_money(net)), lxTitleTx, size.small, lxHeadBg, text.align_left)
    array<string> wd = array.from("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
    for d = 0 to 6
        f_tc(dashTbl, d * 2, 4, array.get(wd, d), lxColHd, size.tiny, lxSubBg)
    int firstDow = dayofweek(timestamp(tz, calY, calM, 1, 12, 0), tz)
    int offs = (firstDow + 5) % 7
    int dim = dayofmonth(timestamp(tz, calY, calM + 1, 1, 12, 0) - 86400000, tz)
    float calNet = 0.0
    int calWinD = 0
    int calTrdD = 0
    float worstD = 0.0
    int worstDay = 0
    for w = 0 to 5
        for d = 0 to 6
            int dayN = w * 7 + d - offs + 1
            bool valid = dayN >= 1 and dayN <= dim
            float dp = valid ? array.get(dP, dayN) : 0.0
            int dn = valid ? array.get(dN, dayN) : 0
            string ct = not valid ? "" : dn == 0 ? str.tostring(dayN) : str.tostring(dayN) + "  (" + str.tostring(dn) + ")\n" + f_money(dp)
            color cb = not valid ? lxRowA : dn == 0 ? lxRowDim : dp >= 0 ? color.new(upC, 75) : color.new(dnC, 70)
            color cf = not valid ? lxRowA : dn == 0 ? lxDimTx : dp >= 0 ? upC : dnC
            f_tc(dashTbl, d * 2, 5 + w, ct, cf, size.tiny, cb)
            if valid and dn > 0
                calNet += dp
                calTrdD += 1
                if dp > 0
                    calWinD += 1
                if dp < worstD
                    worstD := dp
                    worstDay := dayN
    f_tc(dashTbl, 0, 11, "ทั้งเดือน " + f_money(calNet) + "  ·  วันบวก " + str.tostring(calWinD) + "/" + str.tostring(calTrdD), calNet >= 0 ? upC : dnC, size.tiny, lxHeadBg, text.align_left)
    // จุดเสียหนัก
    int worstH = 0
    float worstHv = 0.0
    int bestH = 0
    float bestHv = 0.0
    for h = 0 to 23
        float hv = array.get(hP, h)
        if hv < worstHv
            worstHv := hv
            worstH := h
        if hv > bestHv
            bestHv := hv
            bestH := h
    int worstM = 0
    float worstMv = 0.0
    for m = 1 to 12
        float mv = array.get(mP, m)
        if mv < worstMv
            worstMv := mv
            worstM := m
    f_tc(dashTbl, 0, 12, "วันที่แย่สุด (เดือนนี้): " + (worstDay == 0 ? "-" : str.tostring(worstDay) + "  " + f_money(worstD)), lxRed, size.tiny, lxRowA, text.align_left)
    f_tc(dashTbl, 0, 13, "ชั่วโมงที่แย่สุด: " + (worstHv == 0 ? "-" : str.tostring(worstH) + ":00  " + f_money(worstHv)) + "   ดีสุด: " + (bestHv == 0 ? "-" : str.tostring(bestH) + ":00  " + f_money(bestHv)), lxAmber, size.tiny, lxRowB, text.align_left)
    f_tc(dashTbl, 0, 14, "เดือนที่แย่สุด (ปี " + str.tostring(calY) + "): " + (worstM == 0 ? "-" : f_monthShort(worstM) + "  " + f_money(worstMv)), lxRed, size.tiny, lxRowA, text.align_left)
    // ---------- Equity Curve (ขวา) ----------
    for x = 0 to 13
        int idx = nEq == 0 ? 0 : math.round(x * nEq / 13.0)
        int rowH = math.round((array.get(eq, idx) - eMin) / eRng * 10.0)
        for rr = 0 to 10
            int lvl = 10 - rr
            bool onL = rowH == lvl
            bool below = lvl < rowH
            color zc = lvl == math.round((0 - eMin) / eRng * 10.0) ? color.new(lxMuted, 70) : lxRowA
            table.cell(dashTbl, 14 + x, 4 + rr, "", text_size=size.tiny, bgcolor=onL ? (net >= 0 ? upC : dnC) : below ? color.new(net >= 0 ? upC : dnC, 80) : zc, text_font_family=tblFont)
    // ---------- กำไร/ขาดทุนตามชั่วโมง ----------
    f_tc(dashTbl, 0, 15, "กำไร/ขาดทุนตามชั่วโมง (เวลาปิดไม้)  ·  แย่สุด " + (worstHv == 0 ? "-" : str.tostring(worstH) + ":00 " + f_money(worstHv)) + "  ·  ดีสุด " + (bestHv == 0 ? "-" : str.tostring(bestH) + ":00 " + f_money(bestHv)), lxTitleTx, size.small, lxHeadBg, text.align_left)
    float hMax = math.max(bestHv, -worstHv, 0.000001)
    for c = 0 to 27
        int hrs = c - 2
        float hv = hrs >= 0 and hrs <= 23 ? array.get(hP, hrs) : 0.0
        int bh = math.round(math.abs(hv) / hMax * 4.0)
        for rr = 0 to 7
            bool upper = rr < 4
            int dist = upper ? 4 - rr : rr - 3
            bool fillB = hrs >= 0 and hrs <= 23 and hv != 0 and ((hv > 0 and upper and dist <= bh) or (hv < 0 and not upper and dist <= bh))
            color bc = fillB ? (hv > 0 ? upC : dnC) : (rr == 3 or rr == 4) and hrs >= 0 and hrs <= 23 ? color.new(lxMuted, 85) : lxRowA
            table.cell(dashTbl, c, 16 + rr, "", text_size=size.tiny, bgcolor=bc, text_font_family=tblFont)
        f_tc(dashTbl, c, 24, hrs >= 0 and hrs <= 23 ? str.tostring(hrs) : "", hrs == worstH and worstHv < 0 ? lxRed : hrs == bestH and bestHv > 0 ? lxGreen : lxDimTx, size.tiny, lxRowA)
    // ---------- สรุปรายเดือน ----------
    f_tc(dashTbl, 0, 25, "สรุปรายเดือน ม.ค. - ธ.ค. " + str.tostring(calY) + "  ·  รวม " + f_money(array.sum(mP)), lxTitleTx, size.small, lxHeadBg, text.align_left)
    for m = 1 to 12
        float mv = array.get(mP, m)
        bool has = mv != 0
        f_tc(dashTbl, 2 * m, 26, f_monthShort(m) + "\n" + (has ? f_money(mv) : "-"), not has ? lxDimTx : mv >= 0 ? upC : dnC, size.tiny, not has ? lxRowDim : mv >= 0 ? color.new(upC, 80) : color.new(dnC, 75))
    // ---------- ปัจจัยตรวจสอบ ----------
    f_tc(dashTbl, 0, 27, "ปัจจัยตรวจสอบ Backtest", lxTitleTx, size.small, lxHeadBg, text.align_left)
    float avgW = nW > 0 ? gW / nW : na
    float avgL = nT - nW > 0 ? gL / (nT - nW) : na
    array<string> fl = array.from("ขาดทุนไม้เดียวสูงสุด", "แพ้ติดต่อกันสูงสุด", "เฉลี่ยชนะ / แพ้ ($)", "ไม้ที่ชนะดีสุด", "กำไรรวม / ขาดทุนรวม", "จำนวนไม้ (W / L)", "เฉลี่ย R ชนะ / แพ้", "วันที่มีเทรด (เดือนนี้)")
    array<string> fv = array.from(
         nT == 0 ? "-" : f_money(maxLoss),
         nT == 0 ? "-" : str.tostring(maxLS) + " ไม้",
         nT == 0 ? "-" : (na(avgW) ? "-" : f_money(avgW)) + " / " + (na(avgL) ? "-" : "-" + str.tostring(avgL, "#.#")),
         nT == 0 ? "-" : f_money(bestT),
         nT == 0 ? "-" : f_money(gW) + " / -" + str.tostring(gL, "#.#"),
         nT == 0 ? "-" : str.tostring(nW) + " / " + str.tostring(nT - nW),
         nT == 0 ? "-" : (nW > 0 ? f_rStr(sumWinR / nW) : "-") + " / " + (nT - nW > 0 ? f_rStr(sumLossR / (nT - nW)) : "-"),
         str.tostring(calTrdD) + " / " + str.tostring(dim))
    for k = 0 to 7
        int cc = k % 2 == 0 ? 0 : 14
        int rr = 28 + int(k / 2)
        color bgc = (int(k / 2)) % 2 == 0 ? lxRowA : lxRowB
        f_tc(dashTbl, cc, rr, array.get(fl, k), lxMuted, size.tiny, bgc, text.align_left)
        f_tc(dashTbl, cc + 9, rr, array.get(fv, k), lxText, size.tiny, bgc, text.align_right)
    // ---------- merge เซลล์ (ครั้งเดียว) ----------
    if not mgd
        mgd := true
        table.merge_cells(dashTbl, 0, 0, 27, 0)
        for k = 0 to 6
            table.merge_cells(dashTbl, k * 4, 1, k * 4 + 3, 1)
            table.merge_cells(dashTbl, k * 4, 2, k * 4 + 3, 2)
        table.merge_cells(dashTbl, 0, 3, 13, 3)
        table.merge_cells(dashTbl, 14, 3, 27, 3)
        for d = 0 to 6
            table.merge_cells(dashTbl, d * 2, 4, d * 2 + 1, 4)
            for w = 0 to 5
                table.merge_cells(dashTbl, d * 2, 5 + w, d * 2 + 1, 5 + w)
        for r = 11 to 14
            table.merge_cells(dashTbl, 0, r, 13, r)
        table.merge_cells(dashTbl, 0, 15, 27, 15)
        table.merge_cells(dashTbl, 0, 25, 27, 25)
        for m = 1 to 12
            table.merge_cells(dashTbl, 2 * m, 26, 2 * m + 1, 26)
        table.merge_cells(dashTbl, 0, 27, 27, 27)
        for r = 28 to 31
            table.merge_cells(dashTbl, 0, r, 8, r)
            table.merge_cells(dashTbl, 9, r, 13, r)
            table.merge_cells(dashTbl, 14, r, 22, r)
            table.merge_cells(dashTbl, 23, r, 27, r)

if showDash and statsOn and barstate.islast
    f_drawDash()

// ==========================================
// --- SCOREBOARD ตัวใหญ่: Win / Loss / Win% / Net R ของช่วงเวลาสถิติ ---
// ==========================================
f_drawScore() =>
    int   _w = 0
    int   _l = 0
    float _net = 0.0
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            if f_inStatPeriod(array.get(resTimestamp, i))
                _net += array.get(resTradeRR, i)
                if array.get(resIsWin, i)
                    _w += 1
                else
                    _l += 1
    int   _t = _w + _l
    float _wr = _t > 0 ? _w * 100.0 / _t : na
    array<string> _lab = array.from("WIN", "LOSS", "WIN %", "NET R")
    array<string> _val = array.from(_t == 0 ? "-" : str.tostring(_w), _t == 0 ? "-" : str.tostring(_l), na(_wr) ? "-" : str.tostring(_wr, "#") + "%", _t == 0 ? "-" : f_rStr(_net))
    array<color>  _col = array.from(lxGreen, lxRed, na(_wr) ? lxDimTx : _wr >= 50 ? lxGreen : lxAmber, f_posColor(_net, _t == 0))
    for c = 0 to 3
        f_ut(tScore, 9, c, 0, array.get(_lab, c), lxMuted, size.tiny, lxHeadBg)
        f_ut(tScore, 9, c, 1, array.get(_val, c), array.get(_col, c), size.large, lxRowA)

if onScore and barstate.islast
    f_drawScore()

// ==========================================
// --- 8-BIT ANIMATION: ตัวละครวิ่งเก็บเหรียญหนีผี + ข้อความ Crypto วิ่ง ---
// ==========================================
f_drawGame() =>
    var bool mglG = false
    int _t = int(timenow / 220)
    int _p = _t % 16
    // บรรทัด Pac-Man (บรรทัดเดียว)
    if showPacman
        for c = 0 to 15
            bool _hero = c == _p
            bool _ghost = c == (_p + 13) % 16
            bool _ghost2 = c == (_p + 11) % 16
            string _g = _hero ? (_t % 2 == 0 ? "ᗧ" : "●") : _ghost ? "👻" : _ghost2 ? "ᗣ" : c > _p ? "·" : " "
            color _gc = _hero ? color.rgb(255, 221, 0) : _ghost ? lxText : _ghost2 ? lxColHd : lxCyan
            f_ut(tGame, 8, c, 0, _g, _gc, size.normal, lxRowA)
    // บรรทัดข้อความวิ่ง
    int _rC = showPacman ? 1 : 0
    if showCrypto
        string _mq = "WEN LAMBO?   TO DA MOON?   "
        int _off = int(timenow / 150) % str.length(_mq)
        string _win = str.substring(_mq + _mq + _mq, _off, _off + 30)
        string _lead = _t / 4 % 4 == 0 ? "🚀" : _t / 4 % 4 == 1 ? "🌕" : _t / 4 % 4 == 2 ? "💎" : "🏎️"
        f_ut(tGame, 8, 0, _rC, _lead + " " + _win + " ₿ Ξ", lxAmber, size.normal, lxRowA, text.align_left)
    if not mglG
        mglG := true
        if showCrypto
            f_mg(gameTbl, 0, _rC, 15, _rC)

if onGame and barstate.islast
    f_drawGame()

// ==========================================
// --- ตารางย่อ (Compact) สำหรับ Tablet (iPad) / Phone (มือถือ) ---
// ==========================================
// เลือกที่ "10. Screen / Layout" — Pine ตรวจขนาดจอเองไม่ได้
// Phone  : 4 คอลัมน์ ~5 แถว  = หัว, W / L / WR% / Net R, วันนี้, สถานะ (ออเดอร์เปิด + Radar)
// Tablet : 4 คอลัมน์ ~12 แถว = ข้างบน + Profit $ / PF / Max DD / Streak + แยก BUY/SELL
// ผังแถวขึ้นกับ input เท่านั้น (ไม่ขึ้นกับข้อมูล) จึง merge ครั้งเดียวได้
var table cmpTbl = cmpOn ? table.new(f_tablePos(cmpTablePosStr), 4, 16, bgcolor=lxRowA, frame_width=1, frame_color=lxFrame, border_width=1, border_color=lxGrid) : na

f_cmpCell(int _c, int _r, string _s, color _tc, string _sz, color _bg, string _al) =>
    f_tc(cmpTbl, _c, _r, _s, _tc, _sz, _bg, _al)

f_drawCompact() =>
    var bool mglC = false
    bool  cTab     = not phoneMode
    bool  cTodayOn = not (statMode == "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)" and statUseToday)
    int   cTodayId = year(timenow, tz) * 10000 + month(timenow, tz) * 100 + dayofmonth(timenow, tz)
    int   cW     = 0
    int   cL     = 0
    float cNet   = 0.0
    float cProf  = 0.0
    float cGWR   = 0.0
    float cGLR   = 0.0
    float cPeak  = 0.0
    float cDD    = 0.0
    int   cStrk  = 0
    int   cTW    = 0
    int   cTL    = 0
    float cTNet  = 0.0
    // ต่อฝั่ง g (0 = BUY, 1 = SELL): [W, L, ΣR]
    array<float> cLv = array.new_float(6, 0.0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int   ct   = array.get(resTimestamp, i)
            float cr   = array.get(resTradeRR, i)
            bool  cwin = array.get(resIsWin, i)
            int   cid  = year(ct, tz) * 10000 + month(ct, tz) * 100 + dayofmonth(ct, tz)
            if cid == cTodayId
                cTW   += cwin ? 1 : 0
                cTL   += cwin ? 0 : 1
                cTNet += cr
            if f_inStatPeriod(ct)
                cNet  += cr
                cProf += array.get(resProfit, i)
                cPeak := math.max(cPeak, cNet)
                cDD   := math.max(cDD, cPeak - cNet)
                if cwin
                    cW    += 1
                    cGWR  += cr
                    cStrk := cStrk >= 0 ? cStrk + 1 : 1
                else
                    cL    += 1
                    cGLR  += math.abs(cr)
                    cStrk := cStrk <= 0 ? cStrk - 1 : -1
                int cg = array.get(resBuy, i) ? 0 : 1
                int cq = cg * 3 + (cwin ? 0 : 1)
                array.set(cLv, cq, array.get(cLv, cq) + 1)
                array.set(cLv, cg * 3 + 2, array.get(cLv, cg * 3 + 2) + cr)
    int   cTot  = cW + cL
    float cWr   = cTot > 0 ? cW * 100.0 / cTot : na
    int   cTTot = cTW + cTL
    float cTWr  = cTTot > 0 ? cTW * 100.0 / cTTot : na
    int   cOpB  = 0
    int   cOpS  = 0
    if array.size(tIsBuy) > 0
        for i = 0 to array.size(tIsBuy) - 1
            if array.get(tIsBuy, i)
                cOpB += 1
            else
                cOpS += 1
    // ขนาดตัวอักษร: Phone เล็กสุด, Tablet ใหญ่ขึ้นหนึ่งขั้น
    string cSzLab = size.tiny
    string cSzVal = cTab ? size.normal : size.small
    string cSzTxt = cTab ? size.small : size.tiny
    string cPS = statMode == "1. ย้อนหลังตามจำนวนวัน (Days)" ? str.tostring(statDays) + "D" : statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)" ? str.tostring(statMonths) + "M" : statMode == "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)" ? (statUseToday ? "Today" : str.format_time(statFrom, "dd/MM", tz) + "-" + str.format_time(statTo, "dd/MM", tz)) : f_monthShort(targetMonthNum) + " " + str.tostring(actualTargetY)
    int cr0 = 0
    // หัวตาราง (merge เต็มแถว)
    f_cmpCell(0, cr0, "◆ SWING_BREAK · " + (cTab ? periodStr : cPS), lxTitleTx, cSzTxt, lxHeadBg, text.align_left)
    int cRowTitle = cr0
    cr0 += 1
    // สกอร์: W / L / WR% / Net R
    array<string> cLab = array.from(cTab ? "WIN" : "W", cTab ? "LOSS" : "L", "WR%", "NET R")
    array<string> cVal = array.from(cTot == 0 ? "-" : str.tostring(cW), cTot == 0 ? "-" : str.tostring(cL), na(cWr) ? "-" : str.tostring(cWr, "#") + "%", cTot == 0 ? "-" : f_rStr(cNet))
    array<color>  cCol = array.from(lxGreen, lxRed, na(cWr) ? lxDimTx : cWr >= 50 ? lxGreen : lxAmber, f_posColor(cNet, cTot == 0))
    for c = 0 to 3
        f_cmpCell(c, cr0, array.get(cLab, c), lxMuted, cSzLab, lxSubBg, text.align_center)
        f_cmpCell(c, cr0 + 1, array.get(cVal, c), array.get(cCol, c), cSzVal, lxRowA, text.align_center)
    cr0 += 2
    // Tablet: Profit $ / PF / Max DD / Streak
    if cTab
        float  cPf   = cGLR > 0 ? cGWR / cGLR : na
        string cPfS  = cTot == 0 ? "-" : na(cPf) ? "∞" : str.tostring(cPf, "#.##")
        color  cPfC  = cTot == 0 ? lxDimTx : na(cPf) or cPf >= 1.5 ? lxGreen : cPf >= 1.0 ? lxAmber : lxRed
        string cPrS  = cTot == 0 ? "-" : (cProf >= 0 ? "+$" : "-$") + str.tostring(math.abs(cProf), "#.##")
        string cDdS  = cTot == 0 ? "-" : "-" + str.tostring(cDD, "#.##") + "R"
        string cStS  = cStrk > 0 ? "W" + str.tostring(cStrk) : cStrk < 0 ? "L" + str.tostring(-cStrk) : "-"
        array<string> cLab2 = array.from("PROFIT $", "PF", "MAX DD", "STREAK")
        array<string> cVal2 = array.from(cPrS, cPfS, cDdS, cStS)
        array<color>  cCol2 = array.from(f_posColor(cProf, cTot == 0), cPfC, cDD > 0 ? lxRed : lxDimTx, cStrk > 0 ? lxGreen : cStrk < 0 ? lxRed : lxDimTx)
        for c = 0 to 3
            f_cmpCell(c, cr0, array.get(cLab2, c), lxMuted, cSzLab, lxSubBg, text.align_center)
            f_cmpCell(c, cr0 + 1, array.get(cVal2, c), array.get(cCol2, c), cSzTxt, lxRowB, text.align_center)
        cr0 += 2
    // วันนี้ (ข้ามถ้าช่วงสถิติ = วันนี้อยู่แล้ว)
    if cTodayOn
        f_cmpCell(0, cr0, cTab ? "TODAY" : "วันนี้", lxTitleTx, cSzLab, lxHeadBg, text.align_left)
        f_cmpCell(1, cr0, cTTot == 0 ? "-" : str.tostring(cTW) + "W·" + str.tostring(cTL) + "L", cTTot == 0 ? lxDimTx : lxText, cSzTxt, lxHeadBg, text.align_center)
        f_cmpCell(2, cr0, na(cTWr) ? "-" : str.tostring(cTWr, "#") + "%", na(cTWr) ? lxDimTx : cTWr >= 50 ? lxGreen : lxAmber, cSzTxt, lxHeadBg, text.align_center)
        f_cmpCell(3, cr0, cTTot == 0 ? "-" : f_rStr(cTNet), f_posColor(cTNet, cTTot == 0), cSzTxt, lxHeadBg, text.align_right)
        cr0 += 1
    // Tablet: แยกตามฝั่ง BUY / SELL
    if cTab
        array<string> cHd = array.from("SIDE", "W-L", "WR%", "NET R")
        for c = 0 to 3
            f_cmpCell(c, cr0, array.get(cHd, c), lxColHd, cSzLab, lxSubBg, c == 0 ? text.align_left : text.align_center)
        cr0 += 1
        array<string> cGn = array.from("▲ BUY", "▼ SELL")
        for g = 0 to 1
            int   gw  = int(array.get(cLv, g * 3))
            int   gl  = int(array.get(cLv, g * 3 + 1))
            float gr  = array.get(cLv, g * 3 + 2)
            int   gt  = gw + gl
            float gwr = gt > 0 ? gw * 100.0 / gt : na
            color gbg = g % 2 == 0 ? lxRowA : lxRowB
            f_cmpCell(0, cr0, array.get(cGn, g), gt == 0 ? lxDimTx : lxText, cSzLab, gbg, text.align_left)
            f_cmpCell(1, cr0, gt == 0 ? "-" : str.tostring(gw) + "W·" + str.tostring(gl) + "L", gt == 0 ? lxDimTx : lxText, cSzLab, gbg, text.align_center)
            f_cmpCell(2, cr0, na(gwr) ? "-" : str.tostring(gwr, "#") + "%", na(gwr) ? lxDimTx : gwr >= 50 ? lxGreen : lxAmber, cSzLab, gbg, text.align_center)
            f_cmpCell(3, cr0, gt == 0 ? "-" : f_rStr(gr), f_posColor(gr, gt == 0), cSzLab, gbg, text.align_right)
            cr0 += 1
    // สถานะ: ออเดอร์ที่เปิดอยู่ + Radar (ธีม 8-bit Animation) — merge เต็มแถว
    string cStat = "OPEN " + str.tostring(cOpB) + "B·" + str.tostring(cOpS) + "S"
    color  cStC  = cOpB + cOpS > 0 ? lxCyan : lxMuted
    f_cmpCell(0, cr0, cStat, cStC, cSzLab, lxRowA, text.align_left)
    int cRowStat = cr0
    if not mglC
        mglC := true
        table.merge_cells(cmpTbl, 0, cRowTitle, 3, cRowTitle)
        table.merge_cells(cmpTbl, 0, cRowStat, 3, cRowStat)

if cmpOn and barstate.islast
    f_drawCompact()

// ==========================================
// --- 9.9 EXPORT (Phase 0 ของ EA MQL5): ไม่วาดบนกราฟ แต่ไปอยู่ใน Data Window และ "Export chart data" → CSV เพื่อเทียบสัญญาณ Pine กับ EA ---
// ==========================================
bool sigAny = buySignal or sellSignal
plot(sellSignal ? entryPrice : na, title="EXP sell entry", display=display.data_window)
plot(buySignal  ? entryPrice : na, title="EXP buy entry",  display=display.data_window)
plot(sigAny ? slPrice : na,        title="EXP sl",         display=display.data_window)
plot(sigAny ? tpPrice : na,        title="EXP tp",         display=display.data_window)

// ==========================================
// --- 10. ALERTS ---
// ==========================================
// alertcondition แบบเลือกทีละสัญญาณ (ไม่ต้องใช้ "Any alert() function call") — JSON สำหรับบอท TopstepX โดยไม่มี secret
// ให้ใส่ secret ที่ท้าย Webhook URL แทน ตั้ง Frequency = Once Per Bar (ไม่ใช่ Once Per Bar Close)
alertcondition(buySignal,        title="Swing Break BUY",         message='{"action":"buy","event":"entry","id":"b-{{timenow}}","ts":"{{timenow}}"}')
alertcondition(sellSignal,       title="Swing Break SELL",        message='{"action":"sell","event":"entry","id":"s-{{timenow}}","ts":"{{timenow}}"}')
alertcondition(exitBuyFlat,      title="Swing Break Exit Buy",    message='{"action":"close","event":"exit","id":"xl-{{timenow}}","ts":"{{timenow}}"}')
alertcondition(exitSellFlat,     title="Swing Break Exit Sell",   message='{"action":"close","event":"exit","id":"xs-{{timenow}}","ts":"{{timenow}}"}')
