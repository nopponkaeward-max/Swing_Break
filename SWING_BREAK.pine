//@version=6
indicator("Swing Break (Repaint)", shorttitle="SWING_BREAK", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=1000)

// ==========================================
// --- 1. INPUT SETTINGS ---
// ==========================================
// --- 1. Swing ---
lbL = input.int(5, title="Swing Left Bars (นับซ้ายของ Pivot)", minval=1, maxval=50, group="1. Swing", tooltip="จำนวนแท่งฝั่งซ้ายที่ Pivot ต้องสูงกว่า/ต่ำกว่า", display=display.none)
lbR = input.int(5, title="Swing Right Bars (นับขวา = แท่งรอ Confirm)", minval=1, maxval=50, group="1. Swing", tooltip="จำนวนแท่งฝั่งขวาที่ต้องรอก่อน Swing High / Swing Low ถูก confirm\nยิ่งน้อย Swing เกิดเร็ว แต่ Pivot หลอกมากขึ้น", display=display.none)

// --- 2. Swing Break → Retest 50% (Entry / SL / TP) ---
brkMode       = input.string("ทันทีที่ราคาทะลุ (Intrabar)", "รูปแบบ Entry", options=["ทันทีที่ราคาทะลุ (Intrabar)", "รอแท่งปิด (Bar Close)"], group="2. Swing Break (Entry/SL/TP)", display=display.none, tooltip="Intrabar = เปิดทันทีที่ราคาแตะระดับ 50% ของ retest, Entry อยู่ที่ระดับ 50% พอดี (repaint ระหว่างแท่ง)\nBar Close = ไส้แท่งแตะระดับ 50% (ไม่สนว่าแท่งจะปิดฝั่งไหนของระดับ) แล้วรอแท่งปิด เปิดที่ราคาปิด — ไม่ repaint, สถิติใกล้เคียงการเทรดจริงกว่า (ไม่เช็ค TP/SL ในแท่งที่เปิด)")
slPct         = input.float(100.0, title="  SL = กี่ % ของระยะ Entry→High สูงสุดหลังเบรค (SELL) / Low ต่ำสุดหลังเบรค (BUY)", minval=1.0, maxval=1000.0, step=1.0, group="2. Swing Break (Entry/SL/TP)", display=display.none, tooltip="SELL (หลังเบรค High): ระยะ = Entry ถึง Swing High ที่ถูกเบรค (BUY กลับด้าน)\n100 = SL ที่ Swing นั้น (± buffer)\n50 = SL ครึ่งหนึ่งของระยะนั้น (ใกล้ Entry ขึ้น)\nTP คิดจากระยะ SL ที่ปรับแล้ว (tpRR × ระยะ SL)")
slBufferPts   = input.float(0.0, title="  SL buffer (จุดราคา) นอก Swing ที่ถูกเบรค", minval=0.0, step=0.01, group="2. Swing Break (Entry/SL/TP)", display=display.none)
inBarTP        = input.bool(true, title="  TP ในแท่งเดียวกับที่เปิดออเดอร์ (แท่งทิศเดียวกับออเดอร์)", group="2. Swing Break (Entry/SL/TP)", display=display.none, tooltip="SELL: แท่งขาลง (close<open) และ low ถึง TP = ชนะในแท่งเดียวกัน (BUY กลับด้าน)\nแท่งที่ชนทั้ง TP และ SL ให้ทิศแท่งตัดสิน: ทิศเดียวกับออเดอร์ = TP")
inBarSL        = input.bool(true, title="  SL ในแท่งเดียวกับที่เปิดออเดอร์ (แท่งใหญ่ตรงข้ามออเดอร์)", group="2. Swing Break (Entry/SL/TP)", display=display.none, tooltip="SELL: แท่งขาขึ้น (close>open) และ high ถึง SL = แพ้ในแท่งเดียวกัน (BUY กลับด้าน)\nแท่งที่ชนทั้ง TP และ SL ให้ทิศแท่งตัดสิน: ตรงข้ามออเดอร์ = SL")

// --- 3. Risk Management ---
riskAmount     = input.float(15.0, title="จำนวนเงินที่ยอมเสียต่อรอบ ($)", minval=0.01, group="3. Risk Management", display=display.none)
pipValueRatio  = input.float(0.1,  title="มูลค่าต่อจุดสำหรับ 1 Lot (เช็คกับโบรกเกอร์ก่อนใช้จริง)", minval=0.000001, group="3. Risk Management", display=display.none)

// --- 4. Webhook / Alert ---
whMode        = input.string("Text only (pop-up)", "Alert mode (ใช้กับ Alert แบบ 'Any alert() function call')", options=["Off", "Text only (pop-up)", "OKX Signal Bot", "TopstepX Clicker"], group="4. Webhook / Alert", display=display.none,
     tooltip="ส่งข้อความตอนออเดอร์เปิดและตอนปิด (SL/TP)\nText only = ข้อความอ่านง่าย (ไม่ส่งเข้า OKX/TopstepX)\nOKX Signal Bot = JSON ENTER_/EXIT_ สำหรับ OKX\nTopstepX Clicker = JSON buy/sell/close สำหรับ bot python (กดคีย์ลัด) ต้องตั้ง close_before_entry=false ใน config.json\nสร้าง Alert แล้วเลือก Condition = 'Any alert() function call'")
whSecret      = input.string("CHANGE_ME", "Webhook secret (โหมด TopstepX Clicker)", group="4. Webhook / Alert", display=display.none, tooltip="ต้องตรงกับ secret ใน bot/config.json")
whSignalToken = input.string("", "OKX signalToken (โหมด OKX Signal Bot)", group="4. Webhook / Alert", display=display.none, tooltip="คัดลอกจากหน้าสร้าง Signal ใน OKX ถ้าว่างจะไม่ส่ง")
whInstId      = input.string("XAUUSDT.P", "OKX instrument", group="4. Webhook / Alert", display=display.none, tooltip="ชื่อสัญญาที่ส่งให้ OKX รูปแบบเดียวกับ {{ticker}}")
okxMaxLag     = input.int(120, "OKX Max Lag (วินาที)", minval=1, maxval=3600, group="4. Webhook / Alert", display=display.none, tooltip="ถ้า alert ถึง OKX ช้ากว่านี้ OKX จะยกเลิกสัญญาณ")
okxSizeMode   = input.string("contract", "OKX ขนาดออเดอร์ตอนเข้า", options=["Bot setting", "contract", "margin", "percentage_balance", "percentage_investment"], group="4. Webhook / Alert", display=display.none, tooltip="Bot setting = ไม่ส่งขนาด ใช้ค่าที่ตั้งในหน้า Signal Bot ของ OKX")
okxAmount     = input.float(1.0, "OKX amount ต่อ 1 ออเดอร์ (ตามชนิดด้านบน)", minval=0.0001, step=0.1, group="4. Webhook / Alert", display=display.none, tooltip="ส่งค่านี้ต่อออเดอร์หนึ่งไม้")

// --- 5. Display (กราฟ) ---
tblMode       = input.string("รวมตารางเดียว (All-in-one)", "โหมดแสดงตาราง", options=["แยกตาราง", "รวมตารางเดียว (All-in-one)"], group="5. Display (กราฟ)", display=display.none, tooltip="แยกตาราง = ตารางแยกตามที่เปิดแต่ละตัว\nรวมตารางเดียว = รวมทุกตารางที่เปิดไว้ (หมวด Stats Tables) เป็นตารางเดียว ขนาดคอลัมน์เท่ากัน ตำแหน่งตาม Table Position > All-in-one\nถ้าเปิดมากเกิน 100 แถว ตารางท้ายๆ จะถูกข้าม")
tableTheme    = input.string("8-bit Animation", "Theme ตาราง", options=["Luxe (เดิม)", "8-bit Pixel", "8-bit Animation"], group="5. Display (กราฟ)", display=display.none, tooltip="Luxe = โทนทอง/น้ำเงินเข้มแบบเดิม\n8-bit Pixel = พื้นดำ ตัวอักษร monospace สีนีออนแบบเกมพิกเซลยุคเก่า\n8-bit Animation = ธีม 8-bit + แถบเกมพิกเซล (Pac-Man กินเม็ดไล่หนีผี) ขยับตาม tick ใหม่")
showPacman        = input.bool(true,  title="8-bit Animation: แสดงแถบ Pac-Man", group="5. Display (กราฟ)", display=display.none)
showCrypto        = input.bool(true,  title="8-bit Animation: แสดงข้อความ Crypto (WEN LAMBO วิ่ง)", group="5. Display (กราฟ)", display=display.none)
showEntryLine    = input.bool(true,  title="🔵 แสดง Entry Line (เส้นราคา Entry ยาวจนกว่าจะปิด)", group="5. Display (กราฟ)", display=display.none)
showTradePath    = input.bool(true,  title="↗️ แสดง Trade Path (เส้นจาก Entry → จุดปิด)",      group="5. Display (กราฟ)", display=display.none)
showEntryMarker  = input.bool(true,  title="⭕ แสดงวงกลม + ลูกศร TP/SL ที่จุดเข้าออเดอร์",       group="5. Display (กราฟ)", tooltip="วงกลมใหญ่ที่จุด Entry + ลูกศรชี้ไป TP (เขียว) และ SL (แดง)", display=display.none)
showConfirmLabel = input.bool(true,  title="✅ แสดง Label Confirmed Buy/Sell",                     group="5. Display (กราฟ)", tooltip="แสดง label ข้อมูลออเดอร์ตอนเบรค (Entry/SL/TP/Lot)", display=display.none)
showBreakLine = input.bool(true, title="ลากเส้นประ Swing ที่ถูกเบรค → แท่งที่เปิดออเดอร์", group="5. Display (กราฟ)", display=display.none)
showSwingCount = input.bool(true, title="แสดงเลขนับแท่งของ Swing + จุด Confirm", group="5. Display (กราฟ)", tooltip="ขวา = 1..N (แท่งสุดท้าย ✓ = จุด Confirm), ซ้าย = -1..-N, H/L = แท่ง Pivot\nใช้ label จำนวนมาก ปิดได้ถ้ากราฟช้า", display=display.none)
limitDrawDays     = input.bool(true,  title="จำกัด Drawings ตามช่วงเวลาที่เลือก (ล้างของเก่า)",    group="5. Display (กราฟ)", display=display.none)

// --- 6. Stats Tables ---
showStatsTable    = input.bool(true,  title="แสดงตาราง Main Stats",                              group="6. Stats Tables", display=display.none)
showDayTable      = input.bool(false, title="แสดงตาราง Winrate รายวัน (By Day-of-week)",          group="6. Stats Tables", display=display.none)
showDailyTable    = input.bool(false, title="แสดงตาราง Daily Log (By Date)",                      group="6. Stats Tables", display=display.none)
showMonthlyTable  = input.bool(false, title="แสดงตาราง Monthly Stats (รายเดือน)",                 group="6. Stats Tables", display=display.none)
showEntryTable    = input.bool(true,  title="แสดงตาราง By Direction (สถิติแยก BUY / SELL)", group="6. Stats Tables", display=display.none)
showDateTable     = input.bool(true,  title="แสดงตารางสรุปวันที่เลือก (Selected Date)", group="6. Stats Tables", display=display.none)
showDash          = input.bool(false, title="แสดง Dashboard แยกต่างหาก (ปฏิทินกำไร / Equity / รายเดือน / รายชั่วโมง)", group="6. Stats Tables", display=display.none, tooltip="ตารางใหญ่แยกจากตารางอื่น แสดง KPI, ปฏิทินกำไรรายวัน (เดือนของ 'ถึงวันที่' ในโหมด 4), Equity Curve, สรุปรายเดือนของปีนั้น, กำไร/ขาดทุนตามชั่วโมง, จุดเสียหนัก และปัจจัย backtest")
showScore         = input.bool(true,  title="แสดงสกอร์บอร์ดตัวใหญ่ (Win / Loss / Win% / Net R)", group="6. Stats Tables", display=display.none)
showPerfTable     = input.bool(true,  title="แสดงตาราง Performance (Equity Curve + KPI)", group="6. Stats Tables", display=display.none)
perfAccount       = input.float(0.0, title="  ขนาดบัญชี ($) สำหรับคำนวณ % (0 = ไม่แสดง %)", minval=0.0, group="6. Stats Tables", display=display.none)
showSettingsTable = input.bool(false, title="แสดงตาราง Settings Summary (สรุปการตั้งค่า)",         group="6. Stats Tables", display=display.none)
hideAllStats      = input.bool(false, title="ไม่โชว์ตาราง stat ทั้งหมด (ซ่อนทุกตาราง รวมแถบเกม)", group="6. Stats Tables", display=display.none)

// --- 7. Stats Period ---
statMode       = input.string("2. ย้อนหลังตามจำนวนเดือน (Months)", title="◈ เลือกโหมดสถิติ", options=["1. ย้อนหลังตามจำนวนวัน (Days)", "2. ย้อนหลังตามจำนวนเดือน (Months)", "3. เจาะจงเดือนและปี (Specific Month)", "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)"], group="7. Stats Period", display=display.none)
statDays       = input.int(1,   title="[โหมด 1] ย้อนหลัง (วัน)",  minval=1, maxval=365, group="7. Stats Period", display=display.none)
statMonths     = input.int(8,   title="[โหมด 2] ย้อนหลัง (เดือน) [1-12]", minval=1, maxval=12, group="7. Stats Period", display=display.none)
statTargetM    = input.string("August", title="[โหมด 3] ระบุเดือน", options=["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"], group="7. Stats Period", display=display.none)
statUseToday  = input.bool(true, title="[โหมด 4 / ตารางวันที่] ใช้วันปัจจุบันเสมอ (ข้ามปฏิทิน)", group="7. Stats Period", display=display.none, tooltip="เปิด = ช่วงวันที่ = วันนี้ (ตามเวลาไทย (UTC+7)) อัปเดตอัตโนมัติ\nปิด = ใช้วันที่ที่เลือกในปฏิทินด้านล่าง")
statFrom       = input.time(timestamp("2025-01-01 00:00 +0000"), title="[โหมด 4] จากวันที่ (เลือกในปฏิทิน)", group="7. Stats Period", display=display.none, confirm=false)
statTo         = input.time(timestamp("2025-12-31 00:00 +0000"), title="[โหมด 4] ถึงวันที่ (เลือกในปฏิทิน)", group="7. Stats Period", display=display.none, tooltip="โหมด 4: นับสถิติเฉพาะเทรดที่ปิดในช่วงวันที่ที่เลือก (รวมวันแรกและวันสุดท้าย) ตารางรายวัน (Daily Log) จะแสดงเดือนของ 'ถึงวันที่'", confirm=false)
statTargetY    = input.int(0,   title="[โหมด 3] ระบุปี (ใส่ 0 = ปีปัจจุบัน)", minval=0, maxval=2100, group="7. Stats Period", display=display.none)

// --- 8. Day-of-week Filter ---
tradeMon      = input.bool(true, title="เปิดออเดอร์วัน Monday", group="8. Day-of-week Filter", display=display.none)
tradeTue      = input.bool(true, title="เปิดออเดอร์วัน Tuesday", group="8. Day-of-week Filter", display=display.none)
tradeWed      = input.bool(true, title="เปิดออเดอร์วัน Wednesday", group="8. Day-of-week Filter", display=display.none)
tradeThu      = input.bool(true, title="เปิดออเดอร์วัน Thursday", group="8. Day-of-week Filter", display=display.none)
tradeFri      = input.bool(true, title="เปิดออเดอร์วัน Friday", group="8. Day-of-week Filter", display=display.none)
tradeSat      = input.bool(true, title="เปิดออเดอร์วัน Saturday", group="8. Day-of-week Filter", display=display.none)
tradeSun      = input.bool(true, title="เปิดออเดอร์วัน Sunday", group="8. Day-of-week Filter", display=display.none)
showMon        = input.bool(true, title="  แสดง Monday",    group="8. Day-of-week Filter", display=display.none)
showTue        = input.bool(true, title="  แสดง Tuesday",   group="8. Day-of-week Filter", display=display.none)
showWed        = input.bool(true, title="  แสดง Wednesday", group="8. Day-of-week Filter", display=display.none)
showThu        = input.bool(true, title="  แสดง Thursday",  group="8. Day-of-week Filter", display=display.none)
showFri        = input.bool(true, title="  แสดง Friday",    group="8. Day-of-week Filter", display=display.none)
showSat        = input.bool(true, title="  แสดง Saturday",  group="8. Day-of-week Filter", display=display.none)
showSun        = input.bool(true, title="  แสดง Sunday",    group="8. Day-of-week Filter", display=display.none)
int enabledDayCnt = (showMon ? 1 : 0) + (showTue ? 1 : 0) + (showWed ? 1 : 0) + (showThu ? 1 : 0) + (showFri ? 1 : 0) + (showSat ? 1 : 0) + (showSun ? 1 : 0)

// --- 9. Table Position ---
mainTablePosStr     = input.string("Top Right",     title="◈ ตำแหน่ง Main Stats",      options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
dayTablePosStr      = input.string("Middle Right",  title="◈ ตำแหน่ง By Day-of-week",  options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
dailyTablePosStr    = input.string("Middle Left",   title="◈ ตำแหน่ง Daily Log",       options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
monthlyTablePosStr  = input.string("Bottom Right",  title="◈ ตำแหน่ง Monthly",         options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
entryTablePosStr    = input.string("Middle Right",  title="◈ ตำแหน่ง By Direction", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
uniTablePosStr      = input.string("Top Right",     title="◈ ตำแหน่ง All-in-one", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
dashTablePosStr     = input.string("Middle Center", title="◈ ตำแหน่ง Dashboard", options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
dateTablePosStr     = input.string("Top Left",      title="◈ ตำแหน่ง Selected Date", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
perfTablePosStr     = input.string("Bottom Right",  title="◈ ตำแหน่ง Performance", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
scoreTablePosStr    = input.string("Top Center",    title="◈ ตำแหน่ง Scoreboard", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)
settingsTablePosStr = input.string("Bottom Left",   title="◈ ตำแหน่ง Settings Summary", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="9. Table Position", display=display.none)

// --- 10. Screen / Layout (มือถือ / iPad) ---
// Pine ตรวจขนาดจอ/อุปกรณ์เองไม่ได้ (chart.* มีแค่ช่วงเวลาที่มองเห็น ไม่มีความกว้างจอ) → ให้ผู้ใช้เลือกเอง
// วางไว้ท้ายสุดของ input เพื่อไม่ให้ค่าที่บันทึกไว้ของ input เดิมเลื่อนตำแหน่ง
screenMode     = input.string("Desktop", title="◈ หน้าจอที่ใช้ดูกราฟ (Screen / Layout)", options=["Desktop", "Tablet (iPad)", "Phone (มือถือ)"], group="10. Screen / Layout (มือถือ / iPad)", display=display.none,
     tooltip="Pine ตรวจขนาดจอเองไม่ได้ ให้เลือกตามอุปกรณ์ที่เปิดกราฟ\nDesktop = ตารางเต็มแบบเดิม (ตั้งค่าหมวด 5 / 6 / 9 ตามปกติ)\nTablet (iPad) = ตารางย่อ 4 คอลัมน์: W / L / Win% / Net R, Profit $ / PF / Max DD / Streak, วันนี้, แยก BUY/SELL, ออเดอร์ที่เปิดอยู่\nPhone (มือถือ) = ตารางเล็กสุด ~5 แถว: W / L / WR% / Net R, วันนี้, ออเดอร์ที่เปิดอยู่\nTablet / Phone จะซ่อนตารางเต็มทั้งหมด (All-in-one, Dashboard ปฏิทิน, Daily Log, Monthly, Settings, แถบ Pac-Man)\nซ่อนทุกตารางรวมตารางย่อ: ติ๊ก 'ไม่โชว์ตาราง stat ทั้งหมด' ในหมวด 6")
cmpTablePosStr = input.string("Bottom Left", title="◈ ตำแหน่งตารางย่อ (Tablet / Phone)", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="10. Screen / Layout (มือถือ / iPad)", display=display.none, tooltip="Bottom Left = ชิดมุมล่างซ้าย ทับแท่งเก่า ไม่บังแท่งล่าสุด/ราคาปัจจุบันทางขวา และไม่ทับชื่อ indicator มุมบนซ้าย")
bool cmpMode   = screenMode != "Desktop"
bool phoneMode = screenMode == "Phone (มือถือ)"




// ==========================================
// --- 2. TIMEZONE & HELPERS ---
// ==========================================
// สถิติ/วัน/ชั่วโมง/ตัวกรองวันเทรดทั้งหมดนับตามเวลาประเทศไทยเสมอ (UTC+7)
var tz = "UTC+7"

// Helper: แปลง string → table position
f_tablePos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Middle Center" => position.middle_center
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right

// Helper: แถบ winrate 10 ช่อง ▰▰▰▰▰▱▱▱▱▱
f_wrBar(float pct) =>
    string s = ""
    int filled = na(pct) ? 0 : math.min(10, math.max(0, math.round(pct / 10)))
    for _b = 1 to 10
        s += _b <= filled ? "▰" : "▱"
    s

// Helper: เดือนแบบย่อ
f_monthShort(int m) =>
    switch m
        1  => "Jan"
        2  => "Feb"
        3  => "Mar"
        4  => "Apr"
        5  => "May"
        6  => "Jun"
        7  => "Jul"
        8  => "Aug"
        9  => "Sep"
        10 => "Oct"
        11 => "Nov"
        =>    "Dec"

int selFromTime = statUseToday ? timenow : statFrom
int selToTime   = statUseToday ? timenow : statTo
int selFromId   = year(selFromTime, tz) * 10000 + month(selFromTime, tz) * 100 + dayofmonth(selFromTime, tz)
int selToId     = year(selToTime, tz) * 10000 + month(selToTime, tz) * 100 + dayofmonth(selToTime, tz)
int currentYear   = year(timenow, tz)
int actualTargetY = statMode == "4. เลือกช่วงวันที่ในปฏิทิน (Date Range)" ? year(selToTime, tz) : statTargetY == 0 ? currentYear : statTargetY

// ==========================================
// --- LUXE TABLE THEME (โทนหรู: ทอง + น้ำเงินเข้ม) ---
// ==========================================
bool  gTheme   = tableTheme == "8-bit Animation"
bool  pxTheme  = tableTheme == "8-bit Pixel" or gTheme
string tblFont = pxTheme ? font.family_monospace : font.family_default
// เซลล์ตาราง: ใส่ฟอนต์ของธีมให้ทุกเซลล์ (ฟังก์ชันเดียว ลดจำนวน token ของสคริปต์)
f_tc(table _t, int _c, int _r, string _s, color _tc, string _sz, color _bg, string _al = text.align_center) =>
    table.cell(_t, _c, _r, _s, text_color=_tc, text_size=_sz, bgcolor=_bg, text_halign=_al, text_font_family=tblFont)
color lxGold   = pxTheme ? color.rgb(255, 221, 0) : color.rgb(212, 175, 55)
color lxTitleTx= pxTheme ? color.rgb(0, 255, 120) : color.rgb(236, 210, 140)
color lxHeadBg = pxTheme ? color.new(color.rgb(0, 0, 0), 0) : color.new(color.rgb(26, 32, 52), 6)
color lxSubBg  = pxTheme ? color.new(color.rgb(24, 0, 48), 0) : color.new(color.rgb(19, 24, 40), 8)
color lxColHd  = pxTheme ? color.rgb(255, 0, 200) : color.rgb(150, 160, 182)
color lxRowA   = pxTheme ? color.new(color.rgb(8, 8, 24), 0) : color.new(color.rgb(13, 17, 28), 14)
color lxRowB   = pxTheme ? color.new(color.rgb(20, 12, 40), 0) : color.new(color.rgb(22, 28, 46), 14)
color lxRowDim = pxTheme ? color.new(color.rgb(8, 8, 24), 40) : color.new(color.rgb(13, 17, 28), 52)
color lxText   = pxTheme ? color.rgb(255, 255, 255) : color.rgb(233, 236, 243)
color lxMuted  = pxTheme ? color.rgb(120, 220, 255) : color.rgb(128, 138, 158)
color lxDimTx  = pxTheme ? color.rgb(110, 110, 150) : color.rgb(90, 98, 116)
color lxGreen  = pxTheme ? color.rgb(0, 255, 90) : color.rgb(64, 216, 158)
color lxRed    = pxTheme ? color.rgb(255, 50, 80) : color.rgb(250, 118, 118)
color lxAmber  = pxTheme ? color.rgb(255, 221, 0) : color.rgb(251, 191, 36)
color lxCyan   = pxTheme ? color.rgb(0, 230, 255) : color.rgb(102, 208, 255)
color lxFrame  = pxTheme ? color.rgb(0, 255, 120) : color.new(lxGold, 42)
color lxGrid   = pxTheme ? color.rgb(0, 80, 40) : color.new(color.rgb(7, 10, 17), 35)
color lxBestBg = pxTheme ? color.new(color.rgb(255, 221, 0), 70) : color.new(lxGold, 84)

f_rStr(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R"

f_posColor(float v, bool empty) =>
    empty ? lxDimTx : v > 0 ? lxGreen : v < 0 ? lxRed : lxAmber

// ==========================================
// --- DRAWING REGISTRATION SYSTEM (สำหรับ cleanup ตามช่วงเวลา) ---
// ==========================================
var array<box>   regBoxes     = array.new_box()
var array<int>   regBoxTime   = array.new_int()
var array<line>  regLines     = array.new_line()
var array<int>   regLineTime  = array.new_int()
var array<label> regLabels    = array.new_label()
var array<int>   regLabelTime = array.new_int()

regBox(box _b) =>
    if not na(_b)
        array.push(regBoxes, _b)
        array.push(regBoxTime, time)
        if array.size(regBoxes) > 600
            box.delete(array.shift(regBoxes))
            array.shift(regBoxTime)

regLine(line _l) =>
    if not na(_l)
        array.push(regLines, _l)
        array.push(regLineTime, time)
        if array.size(regLines) > 600
            line.delete(array.shift(regLines))
            array.shift(regLineTime)

regLabel(label _lb) =>
    if not na(_lb)
        array.push(regLabels, _lb)
        array.push(regLabelTime, time)
        if array.size(regLabels) > 600
            label.delete(array.shift(regLabels))
            array.shift(regLabelTime)

// --- Swing pivots ของราคา (Fractal) ---
fracLowVal  = ta.pivotlow(low,  lbL, lbR)
fracHighVal = ta.pivothigh(high, lbL, lbR)

// --- เลขนับแท่ง Swing: วาดย้อนหลังตอน Pivot confirm ---
if showSwingCount and not na(fracHighVal)
    regLabel(label.new(x=bar_index - lbR, y=high[lbR], text="H", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small))
    for k = 1 to lbL
        regLabel(label.new(x=bar_index - lbR - k, y=high[lbR + k], text="-" + str.tostring(k), style=label.style_label_down, color=color.new(color.gray, 100), textcolor=color.new(color.gray, 20), size=size.tiny))
    for k = 1 to lbR
        regLabel(label.new(x=bar_index - lbR + k, y=high[lbR - k], text=(k == lbR ? "✓ Confirm H" : str.tostring(k)), style=label.style_label_down, color=k == lbR ? color.new(color.red, 30) : color.new(color.gray, 100), textcolor=k == lbR ? color.white : color.new(color.red, 10), size=k == lbR ? size.small : size.tiny))
if showSwingCount and not na(fracLowVal)
    regLabel(label.new(x=bar_index - lbR, y=low[lbR], text="L", style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small))
    for k = 1 to lbL
        regLabel(label.new(x=bar_index - lbR - k, y=low[lbR + k], text="-" + str.tostring(k), style=label.style_label_up, color=color.new(color.gray, 100), textcolor=color.new(color.gray, 20), size=size.tiny))
    for k = 1 to lbR
        regLabel(label.new(x=bar_index - lbR + k, y=low[lbR - k], text=(k == lbR ? "✓ Confirm L" : str.tostring(k)), style=label.style_label_up, color=k == lbR ? color.new(color.green, 30) : color.new(color.gray, 100), textcolor=k == lbR ? color.white : color.new(color.green, 10), size=k == lbR ? size.small : size.tiny))

